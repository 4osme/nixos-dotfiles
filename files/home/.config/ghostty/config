# Ghostty Configuration
# Alacritty の見た目を再現 + ネイティブタブ管理

# ── Colors ──
# The palette lives in the dankcolors theme (Dux Shell matugen), set at the
# end of this file.
# ── Font ──
# HackGen Console NF ships in the GUI container (AUR ttf-hackgen-nerd); the
# host ghostty falls back to a host-available monospace CJK font.
font-family = "HackGen Console NF", "Noto Sans Mono CJK JP"
font-size = 12

# ── Window ──
window-padding-x = 0
window-padding-y = 0
background-opacity = 0.9
gtk-titlebar = false
window-decoration = none
window-show-tab-bar = auto
window-theme = ghostty
window-titlebar-background = #000000
window-titlebar-foreground = #ffffff
gtk-toolbar-style = flat
gtk-tabs-location = bottom
gtk-custom-css = ~/.config/ghostty/gtk.css

# ── Cursor ──
cursor-style = block
cursor-style-blink = false

# ── Misc ──
term = xterm-256color
confirm-close-surface = false
mouse-hide-while-typing = true

# ── Keybinds (タブ管理) ──
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+q=close_tab:this
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# ── Keys ──
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard

# ── Theme: Dux Shell matugen palette ──
# Dux Shell writes ~/.config/ghostty/themes/dankcolors on wallpaper/theme
# changes and ghostty follows it live.
theme = dankcolors
app-notifications = no-clipboard-copy,no-config-reload
