+/// Drains the bounded relay queue into the WebSocket.
+///
+/// The frame (and therefore its queue-byte reservation) is dropped when the send
+/// finishes, whether it succeeded, failed or the task is cancelled mid-await.
+async fn ws_sender_task(mut ws_sender: Session, mut relay_receiver: RelayReceiver) {
+    let metrics = relay_receiver.metrics();
+
+    while let Some(frame) = relay_receiver.recv().await {
+        let kind = frame.kind;
+        let size = frame.size;
+        let send_start = Instant::now();
+        let residence = send_start.saturating_duration_since(frame.enqueued_at);
+        let data = frame.data;
+
+        let result = match data {
+            WsData::Bytes(bytes) => ws_sender.binary(bytes).await,
+            WsData::Text(text) => ws_sender.text(text).await,
+        };
+
+        let send_duration = send_start.elapsed();
+
+        match result {
+            Ok(()) => {
+                metrics.record_sent(kind, size, residence, send_duration);
+            }
+            Err(err) => {
+                metrics.record_send_error();
+                debug!(
+                    error = %err,
+                    kind = kind.label(),
+                    send_ms = send_duration.as_millis() as u64,
+                    "web socket send failed, stopping the sender task"
+                );
+                break;
+            }
+        }
+    }
+
+    debug!("stopped web socket sending task");
+}
+
+/// Handles a relay enqueue failure. Returns `true` when the main loop must stop.
+///
+/// A closed queue means the peer/sender is gone. A full queue or an oversized frame
+/// means the session cannot make progress without either growing without bound or
+/// silently dropping deltas; instead of an untested keyframe resync we terminate the
+/// congested session gracefully so the client reconnects (which restarts from a keyframe).
+fn handle_relay_error(
+    err: RelaySendError,
+    relay_sender: &RelaySender,
+    stream: &mut MoonlightStream,
+    metrics: &RelayMetrics,
+) -> bool {
+    match err {
+        RelaySendError::Closed => {
+            debug!("relay queue closed, stopping the stream");
+            // The sender task exits when the WebSocket dies, which can race
+            // ahead of the receiver observing Close. Tell the host explicitly
+            // so the session is not left dangling until its own timeout.
+            let _ = stream.disconnect();
+            true
+        }
+        RelaySendError::Full { .. } | RelaySendError::FrameTooLarge { .. } => {
+            let snapshot = metrics.snapshot();
+            let config = relay_sender.config();
+            warn!(
+                error = %err,
+                queued_bytes = snapshot.queued_bytes,
+                queued_frames = snapshot.queued_frames,
+                peak_queued_bytes = metrics.peak_queued_bytes(),
+                max_queue_bytes = config.max_queued_bytes,
+                max_frame_bytes = config.max_frame_bytes,
+                "relay websocket queue budget exceeded; terminating the congested session so the client can reconnect"
+            );
+            let _ = stream.disconnect();
+            true
+        }
+    }
+}
