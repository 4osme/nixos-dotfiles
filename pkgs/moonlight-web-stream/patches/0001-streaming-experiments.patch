 pub mod web_socket;
 pub mod webrtc;
 
+/// Video packet payload size requested from the Moonlight host.
+///
+/// The host splits each encoded frame into datagrams of about this size, so
+/// larger values save header overhead but must fit the path MTU: 2048 byte
+/// payloads become ~2.1 KiB datagrams once the RTP, UDP and IP headers are
+/// added, which are fragmented into two IP fragments on any normal 1500 byte
+/// link and on a smaller MTU tunnel as well. Fragment loss takes out a whole
+/// frame chunk and doubles the packet rate (a common cause for "the
+/// host -> relay link is too heavy" symptoms without any visible error).
+///
+/// 1392 is Moonlight's classic default and fits PPPoE/1500 byte paths. Check the
+/// real limit with `ping -M do -c1 -s <MTU - 28>` and use
+/// `packet_size = MTU - 28 - 16`: 1456 for a 1500 byte path, 1236 for a 1280
+/// byte Tailscale/WireGuard tunnel. Override it with `moonlight.packet_size` in
+/// the config or `MOONLIGHT_PACKET_SIZE`.
+pub const VIDEO_PACKET_SIZE: u32 = 1392;
+
+/// Apply the preference only after permissions and host capabilities are known.
+/// H264 remains a fallback, never an override of an available preferred AV1 codec.
+fn select_video_formats(
+    supported: VideoFormats,
+    preferred: VideoFormats,
+    host: ServerCodecModeSupport,
+) -> VideoFormats {
+    let mut available = supported;
+    for (format, capability) in [
+        (VideoFormats::AV1_MAIN8, ServerCodecModeSupport::AV1_MAIN8),
+        (VideoFormats::AV1_MAIN10, ServerCodecModeSupport::AV1_MAIN10),
+        (VideoFormats::AV1_HIGH8_444, ServerCodecModeSupport::AV1_HIGH8_444),
+        (VideoFormats::AV1_HIGH10_444, ServerCodecModeSupport::AV1_HIGH10_444),
+    ] {
+        if !host.contains(capability) {
+            available.remove(format);
+        }
+    }
+    let preferred_av1 = available & preferred & VideoFormats::MASK_AV1;
+    if preferred.intersects(VideoFormats::MASK_AV1)
+        && !preferred.intersects(VideoFormats::MASK_H265)
+    {
+        if !preferred_av1.is_empty() {
+            return preferred_av1;
+        }
+        return available & VideoFormats::MASK_H264;
+    }
+    let selected = available & preferred;
+    if selected.is_empty() {
+        available & VideoFormats::MASK_H264
+    } else {
+        selected
+    }
+}
+
 fn server_version() -> ServerVersion {
     ServerVersion::new(7, 0, 0, 0)
 }
+
+#[cfg(test)]
+mod codec_tests {
+    use super::*;
+
+    #[test]
+    fn av1_preference_and_h264_fallback() {
+        let supported = VideoFormats::AV1_MAIN8 | VideoFormats::H264;
+        assert_eq!(
+            select_video_formats(supported, supported, ServerCodecModeSupport::AV1_MAIN8),
+            VideoFormats::AV1_MAIN8,
+        );
+        assert_eq!(
+            select_video_formats(supported, supported, ServerCodecModeSupport::empty()),
+            VideoFormats::H264,
+        );
+    }
+
+    #[test]
+    fn fallback_respects_client_support_and_permissions() {
+        assert!(select_video_formats(
+            VideoFormats::AV1_MAIN8,
+            VideoFormats::AV1_MAIN8 | VideoFormats::H264,
+            ServerCodecModeSupport::empty(),
+        ).is_empty());
+        assert_eq!(select_video_formats(
+            VideoFormats::H264,
+            VideoFormats::AV1_MAIN8 | VideoFormats::H264,
+            ServerCodecModeSupport::AV1_MAIN8,
+        ), VideoFormats::H264);
+    }
+}
 fn create_control_packet_config() -> ControlPacketConfig {
     let mut config =
         ControlPacketConfig::new(server_version(), true).expect("control packet config");
