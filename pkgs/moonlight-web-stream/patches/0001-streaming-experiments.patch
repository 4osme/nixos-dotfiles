+++ b/scripts/prepare-moonlight-common.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+library="$root/rust_modules/moonlight-common-rust"
+patch="$root/patches/moonlight-common-av1.patch"
+revision=cc7ec8c3b3063742f4941500dcb78650bd0a9b98
+
+if [[ ! -d "$library/.git" ]]; then
+    if [[ -e "$library" ]]; then
+        echo "Refusing to overwrite existing non-Git directory: $library" >&2
+        exit 1
+    fi
+    mkdir -p "$(dirname "$library")"
+    git init "$library"
+    git -C "$library" remote add origin https://github.com/MrCreativ3001/moonlight-common-rust.git
+    git -C "$library" fetch --depth=1 origin "$revision"
+    git -C "$library" checkout --detach FETCH_HEAD
+fi
+
+if git -C "$library" apply --ignore-whitespace --reverse --check "$patch" 2>/dev/null; then
+    echo "Moonlight AV1 selection patch is already applied."
+elif git -C "$library" apply --ignore-whitespace --check "$patch"; then
+    git -C "$library" apply --ignore-whitespace "$patch"
+else
+    echo "AV1 patch does not match this checkout; existing changes were not discarded." >&2
+    exit 1
+fi
