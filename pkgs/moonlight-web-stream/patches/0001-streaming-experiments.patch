new file mode 100644
index 0000000..a0387bf
--- /dev/null
+++ b/src/api/stream/ws_relay.rs
@@ -0,0 +1,737 @@
+//! Bounded, byte-accounted outbound relay queue for the WebSocket stream transport.
+//!
+//! The relay reads Moonlight frames from the Sunshine UDP stream and forwards them
+//! to the browser over a WebSocket (TCP, usually through Cloudflare). The UDP driver
+//! must never be stalled by a slow TCP peer, but letting an unbounded queue grow is
+//! not acceptable either: an unresponsive client would make the server grow without
+//! limit.
+//!
+//! This module provides a queue with a hard byte budget and a hard frame-count
+//! budget. Enqueueing is synchronous (`try_send`) so the Moonlight stream keeps
+//! being driven; when the budget is exhausted the caller is expected to terminate
+//! the congested session gracefully instead of silently dropping frames or blocking
+//! the UDP driver. Frames are never dropped while the queue is healthy: the client
+//! protocol is unchanged, and a dropped video delta would need an explicit IDR
+//! resync that this transport does not implement.
+//!
+//! Every queued frame owns a [`QueuePermit`]. The permit releases both the counted
+//! bytes and the semaphore slot on drop, so byte accounting stays correct when a
+//! frame is sent, when a send fails, or when the sender task is cancelled/dropped.
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicU64, AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use bytes::Bytes;
+use tokio::sync::{
+    OwnedSemaphorePermit, Semaphore, TryAcquireError,
+    mpsc::{self, error::TrySendError},
+};
+
+use crate::api::bindings::WebSocketChannel;
+
+/// A send is considered slow once it takes at least this long.
+pub const SLOW_SEND_THRESHOLD: Duration = Duration::from_millis(250);
+
+/// Maximum number of bytes that may be queued (or in flight) at once.
+pub const DEFAULT_MAX_QUEUED_BYTES: usize = 16 * 1024 * 1024;
+/// Maximum size of a single frame. Larger frames are rejected and the session is
+/// terminated instead of being queued (an oversized frame can never fit the budget).
+pub const DEFAULT_MAX_FRAME_BYTES: usize = 8 * 1024 * 1024;
+/// Hard upper bound on queued frames, as a safety net for pathological traffic made
+/// of very small frames. The byte budget is normally the binding limit.
+pub const DEFAULT_MAX_QUEUED_FRAMES: usize = 4096;
+
+/// Queue bounds. All channels (video, audio, control and stats/text) share the same
+/// budget, so none of them can grow without bound.
+#[derive(Clone, Copy, Debug)]
+pub struct RelayQueueConfig {
+    pub max_queued_bytes: usize,
+    pub max_frame_bytes: usize,
+    pub max_queued_frames: usize,
+}
+
+impl Default for RelayQueueConfig {
+    fn default() -> Self {
+        Self {
+            max_queued_bytes: DEFAULT_MAX_QUEUED_BYTES,
+            max_frame_bytes: DEFAULT_MAX_FRAME_BYTES,
+            max_queued_frames: DEFAULT_MAX_QUEUED_FRAMES,
+        }
+    }
+}
+
+/// Logical channel a queued frame belongs to, derived from the wire channel byte.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RelayKind {
+    Control,
+    Video,
+    Audio,
+    Text,
+}
+
+impl RelayKind {
+    fn index(self) -> usize {
+        match self {
+            Self::Control => 0,
+            Self::Video => 1,
+            Self::Audio => 2,
+            Self::Text => 3,
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Control => "control",
+            Self::Video => "video",
+            Self::Audio => "audio",
+            Self::Text => "text",
+        }
+    }
+
+    const ALL: [Self; 4] = [Self::Control, Self::Video, Self::Audio, Self::Text];
+}
+
+/// Payload queued for delivery to the client. The wire format is unchanged.
+pub enum WsData {
+    Bytes(Bytes),
+    Text(String),
+}
+
+impl WsData {
+    #[allow(clippy::len_without_is_empty)]
+    pub fn len(&self) -> usize {
+        match self {
+            Self::Bytes(bytes) => bytes.len(),
+            Self::Text(text) => text.len(),
+        }
+    }
+
+    pub fn kind(&self) -> RelayKind {
+        match self {
+            Self::Text(_) => RelayKind::Text,
+            Self::Bytes(bytes) => match bytes.first().copied() {
+                Some(WebSocketChannel::VIDEO) => RelayKind::Video,
+                Some(WebSocketChannel::AUDIO) => RelayKind::Audio,
+                Some(WebSocketChannel::CONTROL) => RelayKind::Control,
+                // Unknown channel byte: treat as control so it is still bounded and
+                // never silently discarded.
+                _ => RelayKind::Control,
+            },
+        }
+    }
+}
+
+/// Why a frame could not be queued.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum QueueFullReason {
+    Bytes,
+    Frames,
+}
+
+impl std::fmt::Display for QueueFullReason {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Bytes => f.write_str("byte budget exhausted"),
+            Self::Frames => f.write_str("frame budget exhausted"),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RelaySendError {
+    /// The sender task is gone (client disconnected, send failed or task cancelled).
+    Closed,
+    /// The queue budget is exhausted; the session must be terminated.
+    Full { reason: QueueFullReason },
+    /// A single frame exceeds the per-frame limit; the session must be terminated.
+    FrameTooLarge { size: usize, limit: usize },
+}
+
+impl std::fmt::Display for RelaySendError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Closed => f.write_str("relay queue closed"),
+            Self::Full { reason } => write!(f, "relay queue full ({reason})"),
+            Self::FrameTooLarge { size, limit } => write!(
+                f,
+                "relay frame of {size} bytes exceeds the per-frame limit of {limit} bytes"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for RelaySendError {}
+
+/// Cumulative counters plus current gauges. Cheap to clone/copy.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RelaySnapshot {
+    pub queued_bytes: usize,
+    pub queued_frames: usize,
+    pub enqueued_frames: u64,
+    pub enqueued_bytes: u64,
+    pub sent_frames: u64,
+    pub sent_bytes: u64,
+    pub rejected_full: u64,
+    pub rejected_oversize: u64,
+    pub send_errors: u64,
+    pub sent_frames_per_kind: [u64; 4],
+    pub sent_bytes_per_kind: [u64; 4],
+}
+
+/// Extremes observed since the previous call to [`RelayMetrics::take_window`].
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RelayWindow {
+    pub max_queued_bytes: usize,
+    pub max_frame_bytes: usize,
+    pub max_residence_us: u64,
+    pub max_send_us: u64,
+    pub slow_sends: u64,
+}
+
+pub struct RelayMetrics {
+    queued_bytes: AtomicUsize,
+    queued_frames: AtomicUsize,
+    peak_queued_bytes: AtomicUsize,
+
+    enqueued_frames: AtomicU64,
+    enqueued_bytes: AtomicU64,
+    sent_frames: AtomicU64,
+    sent_bytes: AtomicU64,
+    rejected_full: AtomicU64,
+    rejected_oversize: AtomicU64,
+    send_errors: AtomicU64,
+
+    sent_frames_per_kind: [AtomicU64; 4],
+    sent_bytes_per_kind: [AtomicU64; 4],
+
+    window_max_queued_bytes: AtomicUsize,
+    window_max_frame_bytes: AtomicUsize,
+    window_max_residence_us: AtomicU64,
+    window_max_send_us: AtomicU64,
+    window_slow_sends: AtomicU64,
+}
+
+impl Default for RelayMetrics {
+    fn default() -> Self {
+        Self {
+            queued_bytes: AtomicUsize::new(0),
+            queued_frames: AtomicUsize::new(0),
+            peak_queued_bytes: AtomicUsize::new(0),
+            enqueued_frames: AtomicU64::new(0),
+            enqueued_bytes: AtomicU64::new(0),
+            sent_frames: AtomicU64::new(0),
+            sent_bytes: AtomicU64::new(0),
+            rejected_full: AtomicU64::new(0),
+            rejected_oversize: AtomicU64::new(0),
+            send_errors: AtomicU64::new(0),
+            sent_frames_per_kind: std::array::from_fn(|_| AtomicU64::new(0)),
+            sent_bytes_per_kind: std::array::from_fn(|_| AtomicU64::new(0)),
+            window_max_queued_bytes: AtomicUsize::new(0),
+            window_max_frame_bytes: AtomicUsize::new(0),
+            window_max_residence_us: AtomicU64::new(0),
+            window_max_send_us: AtomicU64::new(0),
+            window_slow_sends: AtomicU64::new(0),
+        }
+    }
+}
+
+impl RelayMetrics {
+    pub fn snapshot(&self) -> RelaySnapshot {
+        RelaySnapshot {
+            queued_bytes: self.queued_bytes.load(Ordering::Acquire),
+            queued_frames: self.queued_frames.load(Ordering::Acquire),
+            enqueued_frames: self.enqueued_frames.load(Ordering::Relaxed),
+            enqueued_bytes: self.enqueued_bytes.load(Ordering::Relaxed),
+            sent_frames: self.sent_frames.load(Ordering::Relaxed),
+            sent_bytes: self.sent_bytes.load(Ordering::Relaxed),
+            rejected_full: self.rejected_full.load(Ordering::Relaxed),
+            rejected_oversize: self.rejected_oversize.load(Ordering::Relaxed),
+            send_errors: self.send_errors.load(Ordering::Relaxed),
+            sent_frames_per_kind: self
+                .sent_frames_per_kind
+                .each_ref()
+                .map(|value| value.load(Ordering::Relaxed)),
+            sent_bytes_per_kind: self
+                .sent_bytes_per_kind
+                .each_ref()
+                .map(|value| value.load(Ordering::Relaxed)),
+        }
+    }
+
+    /// Returns the extremes since the previous call and resets them.
+    pub fn take_window(&self) -> RelayWindow {
+        RelayWindow {
+            max_queued_bytes: self.window_max_queued_bytes.swap(0, Ordering::Relaxed),
+            max_frame_bytes: self.window_max_frame_bytes.swap(0, Ordering::Relaxed),
+            max_residence_us: self.window_max_residence_us.swap(0, Ordering::Relaxed),
+            max_send_us: self.window_max_send_us.swap(0, Ordering::Relaxed),
+            slow_sends: self.window_slow_sends.swap(0, Ordering::Relaxed),
+        }
+    }
+
+    pub fn record_sent(&self, kind: RelayKind, size: usize, residence: Duration, send: Duration) {
+        self.sent_frames.fetch_add(1, Ordering::Relaxed);
+        self.sent_bytes.fetch_add(size as u64, Ordering::Relaxed);
+        let index = kind.index();
+        self.sent_frames_per_kind[index].fetch_add(1, Ordering::Relaxed);
+        self.sent_bytes_per_kind[index].fetch_add(size as u64, Ordering::Relaxed);
+
+        self.window_max_residence_us
+            .fetch_max(to_micros(residence), Ordering::Relaxed);
+        let send_us = to_micros(send);
+        self.window_max_send_us.fetch_max(send_us, Ordering::Relaxed);
+        if send >= SLOW_SEND_THRESHOLD {
+            self.window_slow_sends.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    pub fn record_send_error(&self) {
+        self.send_errors.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn peak_queued_bytes(&self) -> usize {
+        self.peak_queued_bytes.load(Ordering::Relaxed)
+    }
+}
+
+fn to_micros(duration: Duration) -> u64 {
+    duration.as_micros().min(u64::MAX as u128) as u64
+}
+
+/// RAII byte reservation. Releasing is unconditional and happens exactly once, even
+/// if the frame is never sent because the send failed or the task was cancelled.
+struct QueuePermit {
+    metrics: Arc<RelayMetrics>,
+    bytes: usize,
+    _semaphore: OwnedSemaphorePermit,
+}
+
+impl Drop for QueuePermit {
+    fn drop(&mut self) {
+        self.metrics.queued_frames.fetch_sub(1, Ordering::AcqRel);
+        self.metrics.queued_bytes.fetch_sub(self.bytes, Ordering::AcqRel);
+    }
+}
+
+/// A frame handed to the sender task. Dropping it releases its queue reservation.
+pub struct QueuedFrame {
+    pub data: WsData,
+    pub kind: RelayKind,
+    pub size: usize,
+    pub enqueued_at: Instant,
+    _permit: QueuePermit,
+}
+
+pub struct RelaySender {
+    tx: mpsc::Sender<QueuedFrame>,
+    budget: Arc<Semaphore>,
+    metrics: Arc<RelayMetrics>,
+    config: RelayQueueConfig,
+}
+
+impl RelaySender {
+    /// Non-blocking enqueue. Never awaits, so the Moonlight UDP driver is not stalled.
+    pub fn try_send(&self, data: WsData) -> Result<(), RelaySendError> {
+        let size = data.len().max(1);
+        if size > self.config.max_frame_bytes {
+            self.metrics.rejected_oversize.fetch_add(1, Ordering::Relaxed);
+            return Err(RelaySendError::FrameTooLarge {
+                size: data.len(),
+                limit: self.config.max_frame_bytes,
+            });
+        }
+
+        let permit = match self.budget.clone().try_acquire_many_owned(size as u32) {
+            Ok(permit) => permit,
+            Err(TryAcquireError::NoPermits) => {
+                self.metrics.rejected_full.fetch_add(1, Ordering::Relaxed);
+                return Err(RelaySendError::Full {
+                    reason: QueueFullReason::Bytes,
+                });
+            }
+            Err(TryAcquireError::Closed) => return Err(RelaySendError::Closed),
+        };
+
+        let queued = self
+            .metrics
+            .queued_bytes
+            .fetch_add(size, Ordering::AcqRel)
+            .saturating_add(size);
+        self.metrics.queued_frames.fetch_add(1, Ordering::AcqRel);
+        self.metrics
+            .window_max_queued_bytes
+            .fetch_max(queued, Ordering::Relaxed);
+        self.metrics
+            .window_max_frame_bytes
+            .fetch_max(size, Ordering::Relaxed);
+
+        let kind = data.kind();
+        let frame = QueuedFrame {
+            data,
+            kind,
+            size,
+            enqueued_at: Instant::now(),
+            _permit: QueuePermit {
+                metrics: self.metrics.clone(),
+                bytes: size,
+                _semaphore: permit,
+            },
+        };
+
+        match self.tx.try_send(frame) {
+            Ok(()) => {
+                self.metrics.enqueued_frames.fetch_add(1, Ordering::Relaxed);
+                self.metrics
+                    .enqueued_bytes
+                    .fetch_add(size as u64, Ordering::Relaxed);
+                Ok(())
+            }
+            Err(TrySendError::Full(frame)) => {
+                drop(frame);
+                self.metrics.rejected_full.fetch_add(1, Ordering::Relaxed);
+                Err(RelaySendError::Full {
+                    reason: QueueFullReason::Frames,
+                })
+            }
+            Err(TrySendError::Closed(frame)) => {
+                drop(frame);
+                Err(RelaySendError::Closed)
+            }
+        }
+    }
+
+    pub fn metrics(&self) -> Arc<RelayMetrics> {
+        self.metrics.clone()
+    }
+
+    pub fn config(&self) -> RelayQueueConfig {
+        self.config
+    }
+}
+
+/// Consumer half. Dropping it closes the channel, which releases every still-queued
+/// frame reservation and makes producers observe [`RelaySendError::Closed`].
+pub struct RelayReceiver {
+    rx: mpsc::Receiver<QueuedFrame>,
+    metrics: Arc<RelayMetrics>,
+}
+
+impl RelayReceiver {
+    pub async fn recv(&mut self) -> Option<QueuedFrame> {
+        self.rx.recv().await
+    }
+
+    pub fn metrics(&self) -> Arc<RelayMetrics> {
+        self.metrics.clone()
+    }
+}
+
+/// Creates the bounded queue and its metrics.
+pub fn new_queue(config: RelayQueueConfig) -> (RelaySender, RelayReceiver) {
+    let max_queued_bytes = config.max_queued_bytes.max(1);
+    let max_frame_bytes = config.max_frame_bytes.min(max_queued_bytes);
+    let max_queued_frames = config.max_queued_frames.max(1);
+    let config = RelayQueueConfig {
+        max_queued_bytes,
+        max_frame_bytes,
+        max_queued_frames,
+    };
+
+    let (tx, rx) = mpsc::channel(max_queued_frames);
+    let metrics = Arc::new(RelayMetrics::default());
+    let budget = Arc::new(Semaphore::new(max_queued_bytes));
+
+    (
+        RelaySender {
+            tx,
+            budget,
+            metrics: metrics.clone(),
+            config,
+        },
+        RelayReceiver { rx, metrics },
+    )
+}
+
+/// Formats a once-per-second aggregated summary. Contains only counts, sizes and
+/// timings, never frame content or credentials.
+pub fn format_summary(
+    now: &RelaySnapshot,
+    prev: &RelaySnapshot,
+    window: &RelayWindow,
+    max_queued_bytes: usize,
+) -> String {
+    let delta = |cur: u64, old: u64| cur.saturating_sub(old);
+    let mut per_kind = String::new();
+    for kind in RelayKind::ALL {
+        let index = kind.index();
+        let frames = delta(now.sent_frames_per_kind[index], prev.sent_frames_per_kind[index]);
+        let bytes = delta(now.sent_bytes_per_kind[index], prev.sent_bytes_per_kind[index]);
+        if frames > 0 {
+            use std::fmt::Write as _;
+            let _ = write!(per_kind, " {}={}f/{}B", kind.label(), frames, bytes);
+        }
+    }
+
+    format!(
+        "relay 1s: queued={}B/{}f peak={}B/{}B max_frame={}B window_peak={}B \
+         enqueued={}f/{}B sent={}f/{}B rejected_full={} rejected_oversize={} send_errors={} \
+         residence_max={}ms send_max={}ms slow_sends={}{}",
+        now.queued_bytes,
+        now.queued_frames,
+        now.queued_bytes.max(window.max_queued_bytes),
+        max_queued_bytes,
+        window.max_frame_bytes,
+        window.max_queued_bytes,
+        delta(now.enqueued_frames, prev.enqueued_frames),
+        delta(now.enqueued_bytes, prev.enqueued_bytes),
+        delta(now.sent_frames, prev.sent_frames),
+        delta(now.sent_bytes, prev.sent_bytes),
+        delta(now.rejected_full, prev.rejected_full),
+        delta(now.rejected_oversize, prev.rejected_oversize),
+        delta(now.send_errors, prev.send_errors),
+        window.max_residence_us / 1000,
+        window.max_send_us / 1000,
+        window.slow_sends,
+        per_kind,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    #![allow(clippy::unwrap_used)]
+
+    use super::*;
+
+    fn bytes(channel: u8, len: usize) -> WsData {
+        let mut buffer = vec![channel];
+        buffer.resize(len.max(1), 0);
+        WsData::Bytes(Bytes::from(buffer))
+    }
+
+    fn small_config() -> RelayQueueConfig {
+        RelayQueueConfig {
+            max_queued_bytes: 1000,
+            max_frame_bytes: 400,
+            max_queued_frames: 8,
+        }
+    }
+
+    #[test]
+    fn byte_accounting_releases_on_frame_drop() {
+        let (sender, mut receiver) = new_queue(small_config());
+        let metrics = sender.metrics();
+
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 300)).unwrap();
+        assert_eq!(metrics.snapshot().queued_bytes, 300);
+        assert_eq!(metrics.snapshot().queued_frames, 1);
+
+        // Dequeued but not dropped yet: the reservation is still held.
+        let frame = receiver.rx.try_recv().unwrap();
+        assert_eq!(frame.size, 300);
+        assert_eq!(metrics.snapshot().queued_bytes, 300);
+
+        drop(frame);
+        assert_eq!(metrics.snapshot().queued_bytes, 0);
+        assert_eq!(metrics.snapshot().queued_frames, 0);
+    }
+
+    #[test]
+    fn queue_limit_rejects_over_byte_budget() {
+        let config = RelayQueueConfig {
+            max_queued_bytes: 500,
+            max_frame_bytes: 400,
+            max_queued_frames: 8,
+        };
+        let (sender, mut receiver) = new_queue(config);
+        let metrics = sender.metrics();
+
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 400)).unwrap();
+        let err = sender.try_send(bytes(WebSocketChannel::VIDEO, 200)).unwrap_err();
+        assert_eq!(
+            err,
+            RelaySendError::Full {
+                reason: QueueFullReason::Bytes
+            }
+        );
+        assert_eq!(metrics.snapshot().rejected_full, 1);
+
+        // Releasing the first frame makes room again.
+        drop(receiver.rx.try_recv().unwrap());
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 200)).unwrap();
+        assert_eq!(metrics.snapshot().queued_bytes, 200);
+    }
+
+    #[test]
+    fn frame_count_budget_is_enforced() {
+        let config = RelayQueueConfig {
+            max_queued_bytes: 1_000_000,
+            max_frame_bytes: 1000,
+            max_queued_frames: 2,
+        };
+        let (sender, mut receiver) = new_queue(config);
+
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 1)).unwrap();
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 1)).unwrap();
+        let err = sender.try_send(bytes(WebSocketChannel::AUDIO, 1)).unwrap_err();
+        assert_eq!(
+            err,
+            RelaySendError::Full {
+                reason: QueueFullReason::Frames
+            }
+        );
+
+        // Dropping a received frame frees a slot.
+        drop(receiver.rx.try_recv().unwrap());
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 1)).unwrap();
+    }
+
+    #[test]
+    fn oversized_single_frame_is_rejected_without_queueing() {
+        let (sender, _receiver) = new_queue(small_config());
+        let metrics = sender.metrics();
+
+        assert_eq!(
+            sender.try_send(bytes(WebSocketChannel::VIDEO, 401)).unwrap_err(),
+            RelaySendError::FrameTooLarge { size: 401, limit: 400 }
+        );
+        // Exactly at the limit is accepted.
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 400)).unwrap();
+
+        let snapshot = metrics.snapshot();
+        assert_eq!(snapshot.rejected_oversize, 1);
+        assert_eq!(snapshot.queued_bytes, 400);
+    }
+
+    #[test]
+    fn closed_channel_reports_closed() {
+        let (sender, receiver) = new_queue(small_config());
+        drop(receiver);
+        assert_eq!(
+            sender.try_send(bytes(WebSocketChannel::VIDEO, 10)).unwrap_err(),
+            RelaySendError::Closed
+        );
+    }
+
+    #[test]
+    fn cancelled_receiver_releases_all_reservations() {
+        let (sender, receiver) = new_queue(small_config());
+        let metrics = sender.metrics();
+
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 200)).unwrap();
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 100)).unwrap();
+        assert_eq!(metrics.snapshot().queued_bytes, 300);
+
+        // Simulates the sender task being cancelled/dropped while frames are queued:
+        // the receiver (and its buffered frames) is dropped, so every permit releases.
+        drop(receiver);
+        assert_eq!(metrics.snapshot().queued_bytes, 0);
+        assert_eq!(metrics.snapshot().queued_frames, 0);
+        assert_eq!(
+            sender.try_send(bytes(WebSocketChannel::VIDEO, 10)).unwrap_err(),
+            RelaySendError::Closed
+        );
+    }
+
+    #[test]
+    fn all_channel_kinds_share_the_byte_budget() {
+        let config = RelayQueueConfig {
+            max_queued_bytes: 100,
+            max_frame_bytes: 100,
+            max_queued_frames: 16,
+        };
+        let (sender, _receiver) = new_queue(config);
+        let metrics = sender.metrics();
+
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 40)).unwrap();
+        sender.try_send(bytes(WebSocketChannel::AUDIO, 30)).unwrap();
+        sender.try_send(bytes(WebSocketChannel::CONTROL, 20)).unwrap();
+        sender.try_send(WsData::Text("{}".to_owned())).unwrap();
+        assert_eq!(metrics.snapshot().queued_bytes, 92);
+
+        let err = sender.try_send(bytes(WebSocketChannel::AUDIO, 10)).unwrap_err();
+        assert_eq!(
+            err,
+            RelaySendError::Full {
+                reason: QueueFullReason::Bytes
+            }
+        );
+    }
+
+    #[test]
+    fn kinds_are_derived_from_wire_channel() {
+        assert_eq!(bytes(WebSocketChannel::VIDEO, 4).kind(), RelayKind::Video);
+        assert_eq!(bytes(WebSocketChannel::AUDIO, 4).kind(), RelayKind::Audio);
+        assert_eq!(bytes(WebSocketChannel::CONTROL, 4).kind(), RelayKind::Control);
+        assert_eq!(WsData::Text("x".to_owned()).kind(), RelayKind::Text);
+    }
+
+    #[test]
+    fn metrics_record_sent_and_errors() {
+        let (sender, receiver) = new_queue(small_config());
+        let metrics = sender.metrics();
+
+        metrics.record_sent(
+            RelayKind::Video,
+            123,
+            Duration::from_millis(10),
+            Duration::from_millis(1),
+        );
+        metrics.record_sent(
+            RelayKind::Video,
+            100,
+            Duration::from_millis(20),
+            Duration::from_millis(300),
+        );
+        metrics.record_send_error();
+
+        let snapshot = metrics.snapshot();
+        assert_eq!(snapshot.sent_frames, 2);
+        assert_eq!(snapshot.sent_bytes, 223);
+        assert_eq!(snapshot.sent_frames_per_kind[RelayKind::Video.index()], 2);
+        assert_eq!(snapshot.send_errors, 1);
+
+        let window = metrics.take_window();
+        assert_eq!(window.max_residence_us, 20_000);
+        assert_eq!(window.max_send_us, 300_000);
+        assert_eq!(window.slow_sends, 1);
+        // take_window resets the window.
+        assert_eq!(metrics.take_window().slow_sends, 0);
+
+        drop(receiver);
+    }
+
+    #[test]
+    fn summary_reports_deltas_and_bounds() {
+        let (sender, receiver) = new_queue(small_config());
+        let metrics = sender.metrics();
+        let prev = metrics.snapshot();
+
+        sender.try_send(bytes(WebSocketChannel::VIDEO, 300)).unwrap();
+        let now = metrics.snapshot();
+        let window = metrics.take_window();
+        let summary = format_summary(&now, &prev, &window, small_config().max_queued_bytes);
+
+        assert!(summary.contains("enqueued=1f/300B"), "{summary}");
+        assert!(summary.contains("queued=300B/1f"), "{summary}");
+        assert!(summary.contains("max_frame=300B"), "{summary}");
+        assert!(!summary.contains("video=0f"), "{summary}");
+        drop(receiver);
+    }
+
+    #[test]
+    fn config_clamps_frame_limit_to_byte_budget() {
+        let config = RelayQueueConfig {
+            max_queued_bytes: 64,
+            max_frame_bytes: 4096,
+            max_queued_frames: 0,
+        };
+        let (sender, _receiver) = new_queue(config);
+        assert_eq!(sender.config().max_frame_bytes, 64);
+        assert_eq!(sender.config().max_queued_frames, 1);
+    }
+}
