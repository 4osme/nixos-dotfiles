@@ -0,0 +1,266 @@
+// @ts-ignore - this project has no type declarations for "bun:test"; the tests
+// are executed with `bun test` (see the report for the exact command) and are
+// still type-checked by `tsc` because the import error is suppressed.
+import { expect, test } from "bun:test"
+import { DecoderRecoveryThresholds, VideoDecoderHealth } from "./video_decoder_health"
+
+class FakeClock {
+    now = 0
+    read = () => this.now
+    advance(ms: number) { this.now += ms }
+}
+
+function createHealth(thresholds?: Partial<DecoderRecoveryThresholds>) {
+    const clock = new FakeClock()
+    const health = new VideoDecoderHealth({ clock: clock.read, thresholds })
+    return { clock, health }
+}
+
+// -- fps validation -----------------------------------------------------------
+
+test("fps validation falls back for 0 / negative / non-finite / out-of-range", () => {
+    const { health } = createHealth()
+
+    expect(health.setFps(0)).toEqual({ raw: 0, fps: 60, valid: false })
+    expect(health.setFps(-30).valid).toBe(false)
+    expect(health.setFps(NaN).valid).toBe(false)
+    expect(health.setFps(Infinity).valid).toBe(false)
+    expect(health.setFps(5000).valid).toBe(false)
+    expect(health.fps).toBe(60)
+
+    expect(health.setFps(120)).toEqual({ raw: 120, fps: 120, valid: true })
+    expect(health.fps).toBe(120)
+    expect(health.fpsValid).toBe(true)
+})
+
+test("fps fallback keeps the queue estimate finite", () => {
+    const { health } = createHealth()
+    health.setFps(0)
+
+    // 13 queued chunks at the fallback 60fps => ~216ms, i.e. shallow enough to
+    // start the sustained-overload timer but never Infinity/NaN.
+    health.pollBacklog(13, 0)
+    const result = health.pollBacklog(13, 300)
+    expect(Number.isFinite(result.reason === null ? 0 : 1)).toBe(true)
+    expect(result.requestIdr).toBe(true)
+})
+
+// -- preserved sustained backlog patch ---------------------------------------
+
+test("a transient burst never triggers the destructive recovery", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+
+    expect(health.pollBacklog(13, 0).requestIdr).toBe(false)
+    // Only 100ms of backlog -> below the 250ms sustain window.
+    expect(health.pollBacklog(13, 100).requestIdr).toBe(false)
+    // Backlog clears.
+    expect(health.pollBacklog(0, 150).requestIdr).toBe(false)
+    // Starts over: 100ms is still not enough.
+    expect(health.pollBacklog(13, 300).requestIdr).toBe(false)
+})
+
+test("a sustained >200ms, >2 chunk backlog requests an IDR + reset after 250ms", () => {
+    const { clock, health } = createHealth()
+    health.setFps(60)
+
+    expect(health.pollBacklog(13, clock.now).requestIdr).toBe(false)
+    clock.advance(200)
+    expect(health.pollBacklog(13, clock.now).requestIdr).toBe(false)
+
+    clock.advance(60) // 260ms total
+    const result = health.pollBacklog(13, clock.now)
+    expect(result.requestIdr).toBe(true)
+    expect(result.reset).toBe(true)
+    expect(result.reason).toContain("sustained decoder backlog")
+})
+
+test("the destructive reset is rate limited to one per cooldown", () => {
+    const { clock, health } = createHealth()
+    health.setFps(60)
+
+    health.pollBacklog(13, 0)
+    clock.advance(260)
+    expect(health.pollBacklog(13, clock.now).requestIdr).toBe(true)
+
+    // Simulate the pipe generating the request + receiving no key frame yet.
+    health.requestIdr(clock.now)
+
+    clock.advance(2100)
+    expect(health.pollBacklog(13, clock.now).requestIdr).toBe(false)
+})
+
+test("a shallow queue (<=2 chunks) is never treated as backlog", () => {
+    const { clock, health } = createHealth()
+    health.setFps(60)
+
+    expect(health.pollBacklog(2, clock.now).requestIdr).toBe(false)
+    clock.advance(5000)
+    expect(health.pollBacklog(2, clock.now).requestIdr).toBe(false)
+})
+
+// -- key frame wait / IDR retry ----------------------------------------------
+
+test("waiting for a key frame re-requests an IDR throttled to ~1s, without reset state", () => {
+    const { clock, health } = createHealth()
+    health.setFps(60)
+    health.markWaitingForKeyFrame(clock.now)
+
+    clock.advance(999)
+    expect(health.pollKeyFrameRetry(clock.now)).toBe(false)
+
+    clock.advance(1)
+    expect(health.pollKeyFrameRetry(clock.now)).toBe(true)
+    health.requestIdr(clock.now)
+
+    // Outstanding request throttles the next retry.
+    clock.advance(500)
+    expect(health.pollKeyFrameRetry(clock.now)).toBe(false)
+
+    clock.advance(500)
+    expect(health.pollKeyFrameRetry(clock.now)).toBe(true)
+    expect(health.keyFrameIdrRetryCount).toBeGreaterThanOrEqual(2)
+})
+
+test("a delta submission must not clear the outstanding IDR / timestamp", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+    health.markWaitingForKeyFrame(0)
+    health.requestIdr(500)
+
+    expect(health.idrOutstanding).toBe(true)
+    expect(health.lastIdrRequestedAt).toBe(500)
+
+    // This used to happen on every delta and silently cancelled the retry.
+    health.noteSubmittedUnit("delta", 1000, 12345, 600)
+    expect(health.idrOutstanding).toBe(true)
+    expect(health.lastIdrRequestedAt).toBe(500)
+
+    // Submitting a key unit is also not enough by itself; the pipe calls
+    // noteKeyFrameReceived once the key frame is actually handed over.
+    health.noteSubmittedUnit("key", 2000, 20000, 700)
+    expect(health.idrOutstanding).toBe(true)
+
+    health.noteKeyFrameReceived()
+    expect(health.idrOutstanding).toBe(false)
+    expect(health.waitingForKeyFrame).toBe(false)
+})
+
+// -- stall detection / static desktop -----------------------------------------
+
+test("an idle static desktop (empty queue) never warns about a stall", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+    health.noteSubmittedUnit("key", 500, 0, 0)
+    health.noteDecodedOutput(10)
+
+    expect(health.checkStall(0, 10 + 60000)).toBeNull()
+})
+
+test("a non-empty queue with no output warns, throttled", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+    health.noteSubmittedUnit("delta", 500, 0, 100)
+    health.noteDecodedOutput(200)
+
+    expect(health.checkStall(1, 200 + 2999)).toBeNull()
+    const warning = health.checkStall(1, 200 + 3000)
+    expect(warning).not.toBeNull()
+    expect(warning).toContain("no output")
+
+    expect(health.checkStall(1, 200 + 3100)).toBeNull()
+})
+
+// -- aggregated logging -------------------------------------------------------
+
+test("units dropped after an error are counted and aggregated, not logged per frame", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+    expect(health.drainLogs(0, 0)).toEqual([]) // baseline
+
+    for (let i = 0; i < 5; i++) {
+        health.noteDroppedAfterError()
+    }
+
+    const out: Record<string, string | number> = {}
+    health.reportStats(out, { queueSize: 0, errored: true, codec: null, waitingForKeyFrame: false }, 100)
+    expect(out.decoderDroppedAfterError).toBe(5)
+
+    const logs = health.drainLogs(0, 2000)
+    expect(logs.length).toBe(1)
+    expect(logs[0]).toContain("droppedAfterError=5")
+})
+
+test("per-frame drops are aggregated into a single periodic log line", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+
+    expect(health.drainLogs(0, 0)).toEqual([]) // baseline
+
+    for (let i = 0; i < 100; i++) {
+        health.noteDroppedTranslatorChunk()
+    }
+    health.noteSubmittedUnit("delta", 100, 0, 100)
+
+    expect(health.drainLogs(0, 1000)).toEqual([])
+    const logs = health.drainLogs(0, 2000)
+    expect(logs.length).toBe(1)
+    expect(logs[0]).toContain("droppedTranslator=100")
+    expect(logs[0]).toContain("submitted=1")
+
+    // Nothing new -> nothing logged.
+    expect(health.drainLogs(0, 4000)).toEqual([])
+})
+
+test("routine frames alone never produce a decoder health log", () => {
+    const { health } = createHealth()
+    health.setFps(60)
+    health.noteKeyFrameReceived()
+
+    expect(health.drainLogs(0, 0)).toEqual([]) // baseline
+
+    // One second of normal 60fps playback: ~1 key + 59 deltas, all decoded.
+    for (let i = 0; i < 60; i++) {
+        health.noteSubmittedUnit(i == 0 ? "key" : "delta", 1000, i * 1000, 100 + i)
+        health.noteDecodedOutput(100 + i)
+    }
+
+    // Routine counters must stay out of the log entirely; they remain visible
+    // through reportStats instead.
+    expect(health.drainLogs(0, 2000)).toEqual([])
+    expect(health.drainLogs(0, 9000)).toEqual([])
+
+    const out: Record<string, string | number> = {}
+    health.reportStats(out, { queueSize: 0, errored: false, codec: null, waitingForKeyFrame: false }, 9200)
+    expect(out.decoderSubmittedUnits).toBe(60)
+    expect(out.decoderDecodedOutputs).toBe(60)
+})
+
+// -- stats --------------------------------------------------------------------
+test("reportStats exposes decode observability without claiming a cause", () => {
+    const { health } = createHealth()
+    health.setFps(59.94)
+    health.noteSubmittedUnit("key", 5000, 111, 0)
+    health.noteSubmittedUnit("delta", 100, 222, 10)
+    health.noteDecodedOutput(30)
+    health.noteDecoderError()
+    health.markWaitingForKeyFrame(30)
+
+    const out: Record<string, string | number> = {}
+    health.reportStats(out, { queueSize: 3, errored: true, codec: "avc3.42E01E", waitingForKeyFrame: true }, 1000)
+
+    expect(out.decoderSubmittedUnits).toBe(2)
+    expect(out.decoderSubmittedKeyUnits).toBe(1)
+    expect(out.decoderSubmittedDeltaUnits).toBe(1)
+    expect(out.decoderDecodedOutputs).toBe(1)
+    expect(out.decoderLargestCompressedFrameBytes).toBe(5000)
+    expect(out.decoderLargestCompressedFrameIsKey).toBe(1)
+    expect(out.decoderQueueSize).toBe(3)
+    expect(out.decoderSinceLastDecodeMs).toBe(970)
+    expect(out.decoderKeyFrameWaiting).toBe(1)
+    expect(out.decoderErrors).toBe(1)
+    expect(out.decoderErrored).toBe(1)
+    expect(out.decoderFpsValid).toBe(1)
+    // There must be no field asserting that hardware acceleration is active.
+    expect(Object.keys(out).some(key => /hardware|hwaccel/i.test(key))).toBe(false)
+})
