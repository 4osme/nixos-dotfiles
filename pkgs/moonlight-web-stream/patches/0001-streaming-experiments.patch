+// @ts-ignore - this project has no type declarations for "bun:test"; the tests
+// run with `bun test` and the import error is suppressed.
+import { expect, test } from "bun:test"
+import { StreamStatsData, streamStatsToText } from "./stats_text"
+
+function data(transport: Record<string, string | number>): StreamStatsData {
+    return { videoPipeline: "ws", audioPipeline: "ws", transport, video: {}, audio: {} }
+}
+
+test("the overlay shows only codec, fps, resolution and the two latencies", () => {
+    const text = streamStatsToText(data({
+        codec: "av1",
+        resolution: "Width: 1920, Height: 1080, Fps: 60",
+        hostToRelayRttMs: 12.4,
+        relayToClientRttMs: 35.6,
+        decoderQueueSize: 3,
+        decoderDecodedOutputs: 12345,
+    }))
+
+    expect(text).toContain("codec: av1")
+    expect(text).toContain("fps: 60")
+    expect(text).toContain("resolution: 1920x1080")
+    expect(text).toContain("host → relay: 12ms")
+    expect(text).toContain("relay → client: 36ms")
+    // The noisy internal counters must not leak into the compact overlay.
+    expect(text).not.toContain("decoder")
+})
+
+test("missing values render as placeholders", () => {
+    const text = streamStatsToText(data({}))
+    expect(text).toContain("codec: ?")
+    expect(text).toContain("fps: ?")
+    expect(text).toContain("resolution: ?")
+    expect(text).toContain("host → relay: ?")
+    expect(text).toContain("relay → client: ?")
+})
+
+test("a malformed resolution string degrades to placeholders", () => {
+    const text = streamStatsToText(data({ resolution: "garbage" }))
+    expect(text).toContain("fps: ?")
+    expect(text).toContain("resolution: ?")
+})
