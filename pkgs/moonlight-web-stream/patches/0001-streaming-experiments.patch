+// @ts-ignore - this project has no type declarations for "bun:test"; the tests
+// run with `bun test` and the import error is suppressed.
+import { expect, test } from "bun:test"
+import { H264_FALLBACK_WINDOW_MS, hintHasNonH264, shouldAbortStalledStream, shouldFallbackToH264 } from "./codec_fallback"
+
+function formats(overrides: Partial<Record<string, boolean>> = {}) {
+    return {
+        h264: true,
+        h264High8444: false,
+        h265: false,
+        h265Main10: false,
+        h265Rext8444: false,
+        h265Rext10444: false,
+        av1Main8: false,
+        av1Main10: false,
+        av1High8444: false,
+        av1High10444: false,
+        ...overrides,
+    }
+}
+
+test("H264-only hints never trigger the fallback", () => {
+    expect(hintHasNonH264(formats())).toBe(false)
+    expect(hintHasNonH264(formats({ h264High8444: true }))).toBe(false)
+    expect(shouldFallbackToH264(formats(), null, 1_000_000, false)).toBe(false)
+})
+
+test("AV1/HEVC hints trigger a retry when the connection never starts", () => {
+    expect(hintHasNonH264(formats({ av1Main8: true }))).toBe(true)
+    expect(shouldFallbackToH264(formats({ av1Main8: true }), null, 0, false)).toBe(true)
+    expect(shouldFallbackToH264(formats({ h265: true }), null, 0, false)).toBe(true)
+})
+
+test("a quick death after connecting triggers the retry", () => {
+    const hint = formats({ av1Main8: true })
+    const connectedAt = 10_000
+    expect(shouldFallbackToH264(hint, connectedAt, connectedAt + 1_000, false)).toBe(true)
+    expect(shouldFallbackToH264(hint, connectedAt, connectedAt + H264_FALLBACK_WINDOW_MS - 1, false)).toBe(true)
+})
+
+test("a long healthy session is not restarted", () => {
+    const hint = formats({ av1Main8: true })
+    const connectedAt = 10_000
+    expect(shouldFallbackToH264(hint, connectedAt, connectedAt + H264_FALLBACK_WINDOW_MS, false)).toBe(false)
+    expect(shouldFallbackToH264(hint, connectedAt, connectedAt + 60_000, false)).toBe(false)
+})
+
+test("the fallback is only attempted once", () => {
+    const hint = formats({ av1Main8: true })
+    expect(shouldFallbackToH264(hint, null, 0, true)).toBe(false)
+})
+
+test("a stalled stream is only aborted when a fallback is possible", () => {
+    const av1 = formats({ av1Main8: true })
+    const h264Only = formats()
+    expect(shouldAbortStalledStream(av1, 9_999, false)).toBe(false)
+    expect(shouldAbortStalledStream(av1, 10_000, false)).toBe(true)
+    expect(shouldAbortStalledStream(av1, 60_000, false)).toBe(true)
+    // Already retried -> never abort again.
+    expect(shouldAbortStalledStream(av1, 60_000, true)).toBe(false)
+    // H264-only hint -> a retry could not change anything.
+    expect(shouldAbortStalledStream(h264Only, 60_000, false)).toBe(false)
+    // No video received at all -> connection handling owns that case.
+    expect(shouldAbortStalledStream(av1, null, false)).toBe(false)
+})
