+// Formatting for the in-stream stats overlay. Deliberately free of transport,
+// DOM and logger imports so it can be unit tested.
+export type StatValue = string | number
+
+export type StreamStatsData = {
+    videoPipeline: string | null
+    audioPipeline: string | null
+    transport: Record<string, StatValue>
+    video: Record<string, StatValue>
+    audio: Record<string, StatValue>
+}
+
+function prettyMs(value: StatValue | undefined): string {
+    return typeof value == "number" ? `${Math.round(value)}ms` : "?"
+}
+
+/// Compact overlay: codec, fps, resolution and the two latency segments.
+/// The detailed decoder/transport counters stay available in the stats data
+/// (and in the logs) but are intentionally not rendered here.
+export function streamStatsToText(statsData: StreamStatsData): string {
+    const transport = statsData.transport
+
+    let fps = "?"
+    let resolution = "?"
+    if (typeof transport.resolution == "string") {
+        const match = /Width:\s*(\d+),\s*Height:\s*(\d+),\s*Fps:\s*([\d.]+)/.exec(transport.resolution)
+        if (match) {
+            resolution = `${match[1]}x${match[2]}`
+            fps = match[3]
+        }
+    }
+
+    return `stats:
+codec: ${transport.codec ?? "?"}
+fps: ${fps}
+resolution: ${resolution}
+host → relay: ${prettyMs(transport.hostToRelayRttMs)}
+relay → client: ${prettyMs(transport.relayToClientRttMs)}
+`
+}
