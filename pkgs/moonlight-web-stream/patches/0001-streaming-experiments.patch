diff --git a/scripts/podman-build-image.sh b/scripts/podman-build-image.sh
new file mode 100644
index 0000000..83d1119
--- /dev/null
+++ b/scripts/podman-build-image.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# Build moonlight-web-stream:local with podman from inside a distrobox WITHOUT
+# breaking `distrobox enter`.
+#
+# Why: distrobox bind-mounts /run/user/$UID from the host, so a podman running
+# inside the container shares the host libpod runtime and overwrites the host
+# pause process (/run/user/$UID/libpod/tmp/pause.pid). The host podman (and
+# therefore `distrobox enter`) then fails. See docker/README.md
+# "Troubleshooting podman inside a container" item 4 and
+# docker/BUILD-WITH-PODMAN.ja.md.
+#
+# The private XDG_RUNTIME_DIR also moves the runroot (default
+# $XDG_RUNTIME_DIR/containers) into the private directory. The image itself
+# still lands in the normal podman storage, so `podman images`, `podman save`
+# and the existing transfer workflow keep working.
+#
+# Usage:
+#   bash scripts/podman-build-image.sh [output.tar]
+#
+# Environment:
+#   PODMAN_BUILD_RUNTIME  private runtime directory (default /tmp/podman-runtime)
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+runtime="${PODMAN_BUILD_RUNTIME:-/tmp/podman-runtime}"
+image=moonlight-web-stream:local
+tar="${1:-$PWD/moonlight-web-stream-local.tar}"
+
+umask 077
+mkdir -p -m 700 "$runtime"
+
+echo "Using private podman runtime: $runtime"
+XDG_RUNTIME_DIR="$runtime" podman build --format docker \
+  -f "$root/docker/Dockerfile.build" \
+  -t "$image" \
+  "$root"
+
+XDG_RUNTIME_DIR="$runtime" podman save --format docker-archive \
+  -o "$tar" "$image"
+
+echo
+echo "Built image:  $image"
+echo "Saved archive: $tar"
+echo "Next: transfer the archive to the relay and run 'docker load -i' there,"
+echo "      then recreate the moonlight-web container (e.g. docker compose up -d --force-recreate)."
