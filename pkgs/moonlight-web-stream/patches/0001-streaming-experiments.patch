--- /dev/null
+++ b/web/stream/codec_fallback.ts
@@ -0,0 +1,65 @@
+// Pure decision logic for the "stream died right after starting" codec
+// fallback. Kept free of DOM/uniffi so it can be unit tested.
+//
+// A host that cannot handle the preferred codec (e.g. AV1 preference against
+// an H264-only host) may fail to start or die right after the first frame.
+// When that happens quickly after connecting (or the connection never
+// establishes), the client retries exactly once with a plain H264-only hint.
+import type { VideoFormats } from "../uniffi/moonlight_common_bindings"
+
+/// A session that lived at least this long is considered a normal session end
+/// and must not be silently restarted.
+export const H264_FALLBACK_WINDOW_MS = 15000
+
+/// A stalled video flow is treated as "the negotiated codec does not actually
+/// work on this host" after this long without any video payload. The first
+/// fallback retry is much faster (session dies immediately); this one covers
+/// the "one frame then frozen forever" case, where the session stays open.
+export const VIDEO_STALL_FALLBACK_MS = 10000
+
+export function hintHasNonH264(hint: VideoFormats): boolean {
+    return hint.h265 || hint.h265Main10 || hint.h265Rext8444 || hint.h265Rext10444
+        || hint.av1Main8 || hint.av1Main10 || hint.av1High8444 || hint.av1High10444
+}
+
+export function shouldFallbackToH264(
+    hint: VideoFormats,
+    lastConnectAt: number | null,
+    now: number,
+    alreadyTried: boolean,
+): boolean {
+    if (alreadyTried) {
+        return false
+    }
+    if (!hintHasNonH264(hint)) {
+        return false
+    }
+    // Never connected -> allow one retry. Connected but ended quickly ->
+    // allow one retry. Connected and lived past the window -> normal end.
+    if (lastConnectAt != null && now - lastConnectAt >= H264_FALLBACK_WINDOW_MS) {
+        return false
+    }
+    return true
+}
+
+/// Should a connected-but-stalled stream be aborted so the H264 fallback can
+/// run? Only when a fallback is still possible and the video flow stopped after
+/// having started (msSinceLastVideo == null means no video arrived yet, which
+/// the normal connection handling covers).
+export function shouldAbortStalledStream(
+    hint: VideoFormats,
+    msSinceLastVideo: number | null,
+    alreadyTried: boolean,
+    threshold = VIDEO_STALL_FALLBACK_MS,
+): boolean {
+    if (alreadyTried) {
+        return false
+    }
+    if (!hintHasNonH264(hint)) {
+        return false
+    }
+    if (msSinceLastVideo == null) {
+        return false
+    }
+    return msSinceLastVideo >= threshold
+}
