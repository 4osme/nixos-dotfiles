index 0000000..cd3c1a7
--- /dev/null
+++ b/web/stream/video/video_decoder_health.ts
@@ -0,0 +1,423 @@
+import type { StatValue } from "../stats"
+
+/// Pure, clock-injected bookkeeping for the VideoDecoder pipe.
+///
+/// This class deliberately has no dependency on browser APIs (`VideoDecoder`,
+/// `performance`, ...) so that the timing / recovery logic can be tested
+/// without a DOM. The pipe owns all side effects (resetting / configuring the
+/// decoder, requesting an IDR over the transport) and this class only decides
+/// *when* those should happen and records what happened.
+///
+/// It exists because video-only scene-change freezes were impossible to
+/// diagnose from the client: there was no visibility into how many decode units
+/// were submitted, how many frames actually came out, how large the compressed
+/// frames were, whether the decoder queue was backing up, or whether we were
+/// stuck waiting for a key frame. Nothing here claims a root cause, it only
+/// measures.
+
+export type DecoderRecoveryThresholds = {
+    /// Estimated decoder backlog (ms) above which we consider the decoder to be
+    /// falling behind. This is the existing "sustained >200ms" patch and must
+    /// be preserved.
+    backlogDelayMs: number
+    /// Only consider the backlog a problem once the queue holds more than this
+    /// many chunks. A single queued frame is normal.
+    backlogMinQueue: number
+    /// The backlog has to persist this long before we act, so that a burst of
+    /// frames delivered by TCP right after a large scene change does not cause
+    /// a destructive reset.
+    backlogSustainMs: number
+    /// After acting on a backlog, do not act again for this long.
+    recoveryCooldownMs: number
+    /// While waiting for a key frame, re-request an IDR at most this often.
+    keyFrameIdrRetryMs: number
+    /// No decoded output for this long *while the queue is non-empty* is
+    /// reported as a stall. An idle static desktop has an empty queue and is
+    /// never reported.
+    stallWarnMs: number
+    /// Aggregated health log lines are emitted at most this often.
+    logIntervalMs: number
+    /// FPS used for the backlog estimate when the stream reports no usable fps.
+    fpsFallback: number
+    fpsMin: number
+    fpsMax: number
+}
+
+export const DEFAULT_DECODER_RECOVERY_THRESHOLDS: DecoderRecoveryThresholds = {
+    backlogDelayMs: 200,
+    backlogMinQueue: 2,
+    backlogSustainMs: 250,
+    recoveryCooldownMs: 2000,
+    keyFrameIdrRetryMs: 1000,
+    stallWarnMs: 3000,
+    logIntervalMs: 2000,
+    fpsFallback: 60,
+    fpsMin: 1,
+    fpsMax: 1000,
+}
+
+export type FpsValidation = {
+    raw: number
+    fps: number
+    valid: boolean
+}
+
+export type BacklogResult = {
+    requestIdr: boolean
+    reset: boolean
+    reason: string | null
+}
+
+export type DecoderHealthStatsInput = {
+    queueSize: number
+    errored: boolean
+    codec: string | null
+    /// Whether the decoder is currently waiting for an in-band codec
+    /// description (H264 SPS/PPS or H265 VPS/SPS/PPS). Only informational.
+    waitingForKeyFrame: boolean
+}
+
+export class VideoDecoderHealth {
+    private readonly thresholds: DecoderRecoveryThresholds
+    private readonly now: () => number
+
+    constructor(options?: { thresholds?: Partial<DecoderRecoveryThresholds>, clock?: () => number }) {
+        this.thresholds = { ...DEFAULT_DECODER_RECOVERY_THRESHOLDS, ...(options?.thresholds ?? {}) }
+        this.now = options?.clock ?? (() => Date.now())
+    }
+
+    // -- fps validation
+    private fpsValue: number = DEFAULT_DECODER_RECOVERY_THRESHOLDS.fpsFallback
+    private fpsRaw: number = 0
+    private fpsIsValid: boolean = false
+
+    setFps(raw: number): FpsValidation {
+        this.fpsRaw = raw
+        const valid = Number.isFinite(raw) && raw >= this.thresholds.fpsMin && raw <= this.thresholds.fpsMax
+        this.fpsIsValid = valid
+        this.fpsValue = valid ? raw : this.thresholds.fpsFallback
+
+        return { raw, fps: this.fpsValue, valid }
+    }
+    get fps(): number {
+        return this.fpsValue
+    }
+    get fpsValid(): boolean {
+        return this.fpsIsValid
+    }
+
+    // -- counters
+    private submittedUnits = 0
+    private submittedKeyUnits = 0
+    private submittedDeltaUnits = 0
+    private decodedOutputs = 0
+    private droppedDeltasBeforeKeyFrame = 0
+    private droppedTranslatorChunks = 0
+    private droppedAfterError = 0
+    private resyncCount = 0
+    private idrRequests = 0
+    private keyFrameWaitCount = 0
+    private keyFrameIdrRetries = 0
+    private decoderErrors = 0
+    private queueHighwater = 0
+
+    private largestCompressedFrameBytes = 0
+    private largestCompressedFrameIsKey = false
+    private largestCompressedFrameTimestampUs = -1
+
+    // -- timestamps (the injected clock's domain)
+    private lastSubmitAt = -1
+    private lastDecodeAt = -1
+    private lastIdrRequestAt = -1
+    private firstSubmitAt = -1
+    private lastStallLogAt = -Infinity
+    private lastSummaryAt = -1
+
+    private keyFrameWaitStartedAt = -1
+    private waitingForKeyFrameState = false
+    private idrOutstandingState = false
+
+    // -- backlog detection state (the preserved sustained >200ms patch)
+    private queueOverloadedAt: number | null = null
+    private lastQueueRecoveryAt = -Infinity
+
+    // -- aggregated summary accounting
+    private summarySubmitted = 0
+    private summarySubmittedKey = 0
+    private summarySubmittedDelta = 0
+    private summaryDecoded = 0
+    private summaryDroppedDelta = 0
+    private summaryDroppedTranslator = 0
+    private summaryDroppedAfterError = 0
+    private summaryErrors = 0
+    private summaryResync = 0
+
+    get waitingForKeyFrame(): boolean {
+        return this.waitingForKeyFrameState
+    }
+    get idrOutstanding(): boolean {
+        return this.idrOutstandingState
+    }
+    get keyFrameIdrRetryCount(): number {
+        return this.keyFrameIdrRetries
+    }
+    get lastIdrRequestedAt(): number {
+        return this.lastIdrRequestAt
+    }
+
+    markWaitingForKeyFrame(now = this.now()): void {
+        if (!this.waitingForKeyFrameState) {
+            this.waitingForKeyFrameState = true
+            this.keyFrameWaitCount++
+        }
+        if (this.keyFrameWaitStartedAt < 0) {
+            this.keyFrameWaitStartedAt = now
+        }
+    }
+
+    /// A key frame was successfully handed to the decoder (or the translator
+    /// now has a codec description). This is the only thing that satisfies an
+    /// outstanding RequestIDR.
+    noteKeyFrameReceived(): void {
+        this.waitingForKeyFrameState = false
+        this.keyFrameWaitStartedAt = -1
+        this.idrOutstandingState = false
+    }
+
+    /// Record that an IDR request was generated. The timestamp is set here every
+    /// time, and is intentionally never cleared by delta submissions.
+    requestIdr(now = this.now()): void {
+        this.idrRequests++
+        this.lastIdrRequestAt = now
+        this.idrOutstandingState = true
+    }
+
+    noteResync(_reason: string): void {
+        this.resyncCount++
+        this.summaryResync++
+    }
+
+    noteDecoderError(): void {
+        this.decoderErrors++
+        this.summaryErrors++
+    }
+
+    noteQueueSize(queueSize: number): void {
+        if (Number.isFinite(queueSize) && queueSize > this.queueHighwater) {
+            this.queueHighwater = queueSize
+        }
+    }
+
+    noteSubmittedUnit(type: "key" | "delta", compressedBytes: number, timestampMicroseconds: number, now = this.now()): void {
+        this.submittedUnits++
+        this.summarySubmitted++
+        if (type == "key") {
+            this.submittedKeyUnits++
+            this.summarySubmittedKey++
+        } else {
+            this.submittedDeltaUnits++
+            this.summarySubmittedDelta++
+        }
+
+        if (this.firstSubmitAt < 0) {
+            this.firstSubmitAt = now
+        }
+        this.lastSubmitAt = now
+
+        if (Number.isFinite(compressedBytes) && compressedBytes > this.largestCompressedFrameBytes) {
+            this.largestCompressedFrameBytes = compressedBytes
+            this.largestCompressedFrameIsKey = type == "key"
+            this.largestCompressedFrameTimestampUs = timestampMicroseconds
+        }
+    }
+
+    noteDroppedDelta(): void {
+        this.droppedDeltasBeforeKeyFrame++
+        this.summaryDroppedDelta++
+    }
+    noteDroppedTranslatorChunk(): void {
+        this.droppedTranslatorChunks++
+        this.summaryDroppedTranslator++
+    }
+    noteDroppedAfterError(): void {
+        this.droppedAfterError++
+        this.summaryDroppedAfterError++
+    }
+    noteDecodedOutput(now = this.now()): void {
+        this.decodedOutputs++
+        this.summaryDecoded++
+        this.lastDecodeAt = now
+    }
+
+    /// The preserved recovery heuristic: only an estimated backlog that is both
+    /// deep and sustained for `backlogSustainMs` triggers a reset + IDR, at
+    /// most once per `recoveryCooldownMs`. `queueOverloadedAt` is cleared as
+    /// soon as the backlog recovers, so a one-off burst never triggers.
+    pollBacklog(queueSize: number, now = this.now()): BacklogResult {
+        this.noteQueueSize(queueSize)
+
+        const estimatedQueueDelayMs = queueSize * 1000 / this.fpsValue
+
+        if (estimatedQueueDelayMs > this.thresholds.backlogDelayMs && queueSize > this.thresholds.backlogMinQueue) {
+            this.queueOverloadedAt ??= now
+
+            if (!this.idrOutstandingState
+                && now - this.queueOverloadedAt >= this.thresholds.backlogSustainMs
+                && now - this.lastQueueRecoveryAt >= this.thresholds.recoveryCooldownMs) {
+                this.lastQueueRecoveryAt = now
+                this.queueOverloadedAt = null
+
+                return {
+                    requestIdr: true,
+                    reset: true,
+                    reason: `sustained decoder backlog queue=${queueSize} estimatedDelayMs=${estimatedQueueDelayMs.toFixed(2)}`,
+                }
+            }
+        } else {
+            this.queueOverloadedAt = null
+        }
+
+        return { requestIdr: false, reset: false, reason: null }
+    }
+
+    /// While waiting for a key frame, keep asking for an IDR (throttled), but
+    /// never reset the decoder again. A reset here would discard whatever
+    /// references remain and reset the wait timer, which is how the old code
+    /// could get stuck.
+    pollKeyFrameRetry(now = this.now()): boolean {
+        if (!this.waitingForKeyFrameState) {
+            return false
+        }
+        if (this.keyFrameWaitStartedAt < 0) {
+            this.keyFrameWaitStartedAt = now
+        }
+        if (now - this.keyFrameWaitStartedAt < this.thresholds.keyFrameIdrRetryMs) {
+            return false
+        }
+        if (this.idrOutstandingState && now - this.lastIdrRequestAt < this.thresholds.keyFrameIdrRetryMs) {
+            return false
+        }
+
+        this.keyFrameIdrRetries++
+        return true
+    }
+
+    keyFrameWaitMs(now = this.now()): number {
+        if (!this.waitingForKeyFrameState || this.keyFrameWaitStartedAt < 0) {
+            return -1
+        }
+        return Math.round(now - this.keyFrameWaitStartedAt)
+    }
+
+    /// Returns a warning string when the decoder has queued work but produced
+    /// no output for `stallWarnMs`. An idle static desktop keeps the queue at
+    /// zero, so it never warns. Throttled to one warning per log interval.
+    checkStall(queueSize: number, now = this.now()): string | null {
+        if (queueSize <= 0) {
+            return null
+        }
+
+        const reference = this.lastDecodeAt >= 0 ? this.lastDecodeAt : Math.max(this.lastSubmitAt, this.firstSubmitAt)
+        if (reference < 0 || now - reference < this.thresholds.stallWarnMs) {
+            return null
+        }
+        if (now - this.lastStallLogAt < this.thresholds.logIntervalMs) {
+            return null
+        }
+        this.lastStallLogAt = now
+
+        return `decoder produced no output for ${Math.round(now - reference)}ms while queue=${queueSize} (waitingForKeyFrame=${this.waitingForKeyFrameState}, idrOutstanding=${this.idrOutstandingState})`
+    }
+
+    /// Returns aggregated log lines. Emitted at most once per `logIntervalMs`
+    /// and **only when the window contains something notable**: dropped units,
+    /// errors, resyncs, or an outstanding key-frame wait. Routine frames are
+    /// still counted and exposed through `reportStats`, but they never produce
+    /// log lines, so steady-state streaming stays quiet.
+    drainLogs(queueSize: number, now = this.now()): Array<string> {
+        if (this.lastSummaryAt < 0) {
+            this.lastSummaryAt = now
+            return []
+        }
+        if (now - this.lastSummaryAt < this.thresholds.logIntervalMs) {
+            return []
+        }
+        this.lastSummaryAt = now
+
+        const notable = this.summaryDroppedDelta > 0
+            || this.summaryDroppedTranslator > 0
+            || this.summaryDroppedAfterError > 0
+            || this.summaryErrors > 0
+            || this.summaryResync > 0
+            || this.waitingForKeyFrameState
+            || this.idrOutstandingState
+
+        const sinceLastDecodeMs = this.lastDecodeAt < 0 ? -1 : Math.round(now - this.lastDecodeAt)
+
+        const line = `decoder health: submitted=${this.summarySubmitted}`
+            + ` (key=${this.summarySubmittedKey} delta=${this.summarySubmittedDelta})`
+            + ` decoded=${this.summaryDecoded}`
+            + ` droppedDelta=${this.summaryDroppedDelta}`
+            + ` droppedTranslator=${this.summaryDroppedTranslator}`
+            + ` droppedAfterError=${this.summaryDroppedAfterError}`
+            + ` errors=${this.summaryErrors}`
+            + ` queue=${queueSize} highwater=${this.queueHighwater}`
+            + ` largestCompressedFrame=${this.largestCompressedFrameBytes}B`
+            + ` sinceLastDecodeMs=${sinceLastDecodeMs}`
+            + ` waitingForKeyFrame=${this.waitingForKeyFrameState}`
+            + ` resync=${this.resyncCount}`
+            + ` idrRequests=${this.idrRequests}`
+            + ` keyFrameIdrRetries=${this.keyFrameIdrRetries}`
+
+        this.summarySubmitted = 0
+        this.summarySubmittedKey = 0
+        this.summarySubmittedDelta = 0
+        this.summaryDecoded = 0
+        this.summaryDroppedDelta = 0
+        this.summaryDroppedTranslator = 0
+        this.summaryDroppedAfterError = 0
+        this.summaryErrors = 0
+        this.summaryResync = 0
+
+        return notable ? [line] : []
+    }
+
+    reportStats(out: Record<string, StatValue>, input: DecoderHealthStatsInput, now = this.now()): void {
+        this.noteQueueSize(input.queueSize)
+
+        out.decoderCodec = input.codec ?? "unknown"
+        out.decoderFps = this.fpsValue
+        out.decoderFpsValid = this.fpsIsValid ? 1 : 0
+        out.decoderFpsRaw = this.fpsRaw
+
+        out.decoderSubmittedUnits = this.submittedUnits
+        out.decoderSubmittedKeyUnits = this.submittedKeyUnits
+        out.decoderSubmittedDeltaUnits = this.submittedDeltaUnits
+        out.decoderDecodedOutputs = this.decodedOutputs
+        out.decoderDroppedDeltasBeforeKeyFrame = this.droppedDeltasBeforeKeyFrame
+        out.decoderDroppedTranslatorChunks = this.droppedTranslatorChunks
+        out.decoderDroppedAfterError = this.droppedAfterError
+
+        out.decoderLargestCompressedFrameBytes = this.largestCompressedFrameBytes
+        out.decoderLargestCompressedFrameIsKey = this.largestCompressedFrameIsKey ? 1 : 0
+        out.decoderLargestCompressedFrameTimestampUs = this.largestCompressedFrameTimestampUs
+
+        out.decoderQueueSize = input.queueSize
+        out.decoderQueueHighwater = this.queueHighwater
+        out.decoderSinceLastDecodeMs = this.lastDecodeAt < 0 ? -1 : Math.round(now - this.lastDecodeAt)
+        out.decoderSinceLastSubmitMs = this.lastSubmitAt < 0 ? -1 : Math.round(now - this.lastSubmitAt)
+        out.decoderSinceLastIdrRequestMs = this.lastIdrRequestAt < 0 ? -1 : Math.round(now - this.lastIdrRequestAt)
+
+        out.decoderResyncCount = this.resyncCount
+        out.decoderIdrRequests = this.idrRequests
+        out.decoderIdrOutstanding = this.idrOutstandingState ? 1 : 0
+
+        out.decoderKeyFrameWaiting = (input.waitingForKeyFrame || this.waitingForKeyFrameState) ? 1 : 0
+        out.decoderKeyFrameWaitMs = this.keyFrameWaitMs(now)
+        out.decoderKeyFrameWaits = this.keyFrameWaitCount
+        out.decoderKeyFrameIdrRetries = this.keyFrameIdrRetries
+
+        out.decoderErrors = this.decoderErrors
+        out.decoderErrored = input.errored ? 1 : 0
+    }
+}
