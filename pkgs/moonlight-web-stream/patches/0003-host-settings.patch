new file mode 100644
index 0000000..9c5cac8
--- /dev/null
+++ b/web/component/host_settings.ts
@@ -0,0 +1,44 @@
+// Per-host stream settings overrides.
+//
+// The base stream settings are stored globally under "mlSettings". A host
+// override is a full settings snapshot stored under "mlSettings:host:<hostId>"
+// that is merged over the base when a stream for that host starts. This lets a
+// host which cannot handle the default codec (for example an H264-only host
+// while the base uses AV1) be configured once, without changing the settings
+// for every other host.
+//
+// The module deliberately has no DOM/browser imports (only a type-only import)
+// so its logic can be unit tested.
+import type { Settings } from "./settings_menu"
+
+export const HOST_SETTINGS_PREFIX = "mlSettings:host:"
+
+export function hostSettingsKey(hostId: number): string {
+    return `${HOST_SETTINGS_PREFIX}${hostId}`
+}
+
+export function loadHostSettings(hostId: number): Partial<Settings> | null {
+    try {
+        const json = localStorage.getItem(hostSettingsKey(hostId))
+        if (!json) {
+            return null
+        }
+        return JSON.parse(json)
+    } catch (e) {
+        // Corrupt entries must not break every stream for this host.
+        localStorage.removeItem(hostSettingsKey(hostId))
+        return null
+    }
+}
+
+export function hasHostSettings(hostId: number): boolean {
+    return localStorage.getItem(hostSettingsKey(hostId)) != null
+}
+
+export function saveHostSettings(hostId: number, settings: Settings): void {
+    localStorage.setItem(hostSettingsKey(hostId), JSON.stringify(settings))
+}
+
+export function clearHostSettings(hostId: number): void {
+    localStorage.removeItem(hostSettingsKey(hostId))
+}
