diff --git a/web/component/host_settings.test.ts b/web/component/host_settings.test.ts
new file mode 100644
index 0000000..eabc0aa
--- /dev/null
+++ b/web/component/host_settings.test.ts
@@ -0,0 +1,64 @@
+// @ts-ignore - this project has no type declarations for "bun:test"; the tests
+// run with `bun test` and the import error is suppressed.
+import { expect, test } from "bun:test"
+import { clearHostSettings, hasHostSettings, hostSettingsKey, loadHostSettings, saveHostSettings } from "./host_settings"
+
+class MemoryStorage {
+    private map = new Map<string, string>()
+
+    getItem(key: string): string | null {
+        return this.map.has(key) ? this.map.get(key)! : null
+    }
+    setItem(key: string, value: string): void {
+        this.map.set(key, value)
+    }
+    removeItem(key: string): void {
+        this.map.delete(key)
+    }
+    clear(): void {
+        this.map.clear()
+    }
+}
+
+// The module only touches localStorage inside functions, so installing the
+// stub at module scope is safe even with hoisted imports.
+;(globalThis as any).localStorage = new MemoryStorage()
+
+function settingsSnapshot() {
+    return {
+        bitrate: 4000,
+        videoCodec: "h264" as const,
+    } as any
+}
+
+test("host settings round-trip and stay scoped to the host", () => {
+    localStorage.clear()
+
+    expect(hasHostSettings(7)).toBe(false)
+    expect(loadHostSettings(7)).toBeNull()
+
+    saveHostSettings(7, settingsSnapshot())
+
+    expect(hasHostSettings(7)).toBe(true)
+    expect(hasHostSettings(8)).toBe(false)
+    const loaded = loadHostSettings(7)
+    expect(loaded?.videoCodec).toBe("h264")
+    expect(loaded?.bitrate).toBe(4000)
+
+    clearHostSettings(7)
+    expect(hasHostSettings(7)).toBe(false)
+    expect(loadHostSettings(7)).toBeNull()
+})
+
+test("the key never collides with the global settings key", () => {
+    expect(hostSettingsKey(1)).toBe("mlSettings:host:1")
+    expect(hostSettingsKey(1)).not.toBe("mlSettings")
+})
+
+test("corrupt entries are removed instead of breaking the host", () => {
+    localStorage.clear()
+    localStorage.setItem(hostSettingsKey(3), "{not json")
+
+    expect(loadHostSettings(3)).toBeNull()
+    expect(localStorage.getItem(hostSettingsKey(3))).toBeNull()
+})
