+fn select_av1_format(host: ServerCodecModeSupport, client: VideoFormats) -> Option<VideoFormat> {
+    [
+        (
+            ServerCodecModeSupport::AV1_HIGH10_444,
+            VideoFormats::AV1_HIGH10_444,
+            VideoFormat::Av1High10_444,
+        ),
+        (
+            ServerCodecModeSupport::AV1_MAIN10,
+            VideoFormats::AV1_MAIN10,
+            VideoFormat::Av1Main10,
+        ),
+        (
+            ServerCodecModeSupport::AV1_HIGH8_444,
+            VideoFormats::AV1_HIGH8_444,
+            VideoFormat::Av1High8_444,
+        ),
+        (
+            ServerCodecModeSupport::AV1_MAIN8,
+            VideoFormats::AV1_MAIN8,
+            VideoFormat::Av1Main8,
+        ),
+    ]
+    .into_iter()
+    .find_map(|(capability, supported, format)| {
+        (host.contains(capability) && client.contains(supported)).then_some(format)
+    })
+}
+
+#[cfg(test)]
+mod av1_selection_tests {
+    use super::*;
+
+    #[test]
+    fn selects_av1_when_h264_is_also_allowed() {
+        assert_eq!(
+            select_av1_format(
+                ServerCodecModeSupport::AV1_MAIN8,
+                VideoFormats::AV1_MAIN8 | VideoFormats::H264,
+            ),
+            Some(VideoFormat::Av1Main8)
+        );
+    }
+
+    #[test]
+    fn requires_a_matching_host_and_client_profile() {
+        assert_eq!(
+            select_av1_format(ServerCodecModeSupport::empty(), VideoFormats::AV1_MAIN8),
+            None
+        );
+        assert_eq!(
+            select_av1_format(ServerCodecModeSupport::AV1_MAIN8, VideoFormats::H264),
+            None
+        );
+        assert_eq!(
+            select_av1_format(ServerCodecModeSupport::AV1_MAIN10, VideoFormats::AV1_MAIN8),
+            None
+        );
+    }
+
+    #[test]
+    fn prefers_ten_bit_but_falls_back_to_mutual_eight_bit() {
+        let client = VideoFormats::AV1_MAIN8 | VideoFormats::AV1_MAIN10;
+        assert_eq!(
+            select_av1_format(
+                ServerCodecModeSupport::AV1_MAIN8 | ServerCodecModeSupport::AV1_MAIN10,
+                client,
+            ),
+            Some(VideoFormat::Av1Main10)
+        );
+        assert_eq!(
+            select_av1_format(ServerCodecModeSupport::AV1_MAIN8, client),
+            Some(VideoFormat::Av1Main8)
+        );
+    }
+}
