+#!/usr/bin/env bash
+# Runs the dedicated JIS client tests.
+#
+# Prefers a host node install, otherwise falls back to a transient run of the
+# existing node image with podman. It never creates, restarts or modifies
+# containers, volumes or podman storage: `--rm` leaves nothing behind.
+#
+#   tests/jis/run.sh
+#   JIS_TEST_NODE_IMAGE=node:26-bookworm tests/jis/run.sh
+set -euo pipefail
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$repo_root"
+
+test_files=(
+    tests/jis/keyboard.test.ts
+    tests/jis/input.test.ts
+)
+
+if command -v node >/dev/null 2>&1; then
+    for test_file in "${test_files[@]}"; do
+        node --import ./tests/jis/register.mjs "$test_file"
+    done
+    exit 0
+fi
+
+if command -v podman >/dev/null 2>&1; then
+    image="${JIS_TEST_NODE_IMAGE:-node:26-bookworm}"
+    for test_file in "${test_files[@]}"; do
+        podman run --rm -v "$repo_root":/src:ro -w /src "$image" \
+            node --import ./tests/jis/register.mjs "$test_file"
+    done
+    exit 0
+fi
+
+echo "Neither node nor podman is available; cannot run the JIS tests." >&2
+exit 1
