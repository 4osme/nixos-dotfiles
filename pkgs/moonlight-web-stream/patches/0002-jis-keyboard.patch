new file mode 100644
index 0000000..d643aa9
--- /dev/null
+++ b/tests/jis/input.test.ts
@@ -0,0 +1,137 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+
+import { StreamKeys } from "../../web/api_bindings.ts"
+import { StreamInput } from "../../web/stream/input.ts"
+import { KeyAction } from "./stubs.mjs"
+
+function keyEvent(overrides: Record<string, unknown> = {}): KeyboardEvent {
+    return {
+        type: "keydown",
+        code: "",
+        key: "",
+        keyCode: 0,
+        isComposing: false,
+        repeat: false,
+        shiftKey: false,
+        ctrlKey: false,
+        altKey: false,
+        metaKey: false,
+        ...overrides,
+    } as unknown as KeyboardEvent
+}
+
+function setup() {
+    const sent: any[] = []
+    const logs: string[] = []
+
+    const input = new StreamInput()
+    input.setControlStream({
+        send: (packet: any) => sent.push(packet),
+        sendRaw: () => { },
+    } as any)
+    input.setLogger({ debug: (message: string) => logs.push(message) } as any)
+
+    return { input, sent, logs }
+}
+
+const jisDiag = (logs: string[]) => logs.filter(line => line.includes("JIS diag"))
+
+test("半角/全角 is sent as a single non normalized tap", () => {
+    const { input, sent, logs } = setup()
+
+    input.onKeyDown(keyEvent({ key: "Hankaku", code: "Backquote", keyCode: 0x15 }))
+
+    assert.equal(sent.length, 2, "must send exactly one down/up tap")
+    assert.equal(sent[0].data.action, KeyAction.Down)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_OEM_3)
+    assert.equal(sent[0].data.flags.sunshineNonNormalized, true)
+    assert.equal(sent[1].data.action, KeyAction.Up)
+    assert.equal(sent[1].data.keyCode, StreamKeys.VK_OEM_3)
+    assert.equal(sent[1].data.flags.sunshineNonNormalized, true)
+
+    // The client IME often sends no keyup; receiving one must not send again.
+    input.onKeyUp(keyEvent({ key: "Hankaku", code: "Backquote", keyCode: 0x15 }))
+    assert.equal(sent.length, 2)
+
+    const diag = jisDiag(logs)
+    assert.equal(diag.length, 2, "down and up should both be diagnosed")
+    assert.ok(diag[0].includes("state=down"))
+    assert.ok(diag[0].includes("code=Backquote"))
+    assert.ok(diag[0].includes("key=Hankaku"))
+    assert.ok(diag[0].includes("keyCode=21"))
+    assert.ok(diag[0].includes("isComposing=false"))
+    assert.ok(diag[0].includes("repeat=false"))
+    assert.ok(diag[0].includes(`mapped=${StreamKeys.VK_OEM_3}`))
+    assert.ok(diag[0].includes("nonNormalized=true"))
+})
+
+test("auto repeat of an IME toggle does not send repeated taps", () => {
+    const { input, sent } = setup()
+
+    input.onKeyDown(keyEvent({ key: "KanaMode", code: "KanaMode", repeat: true }))
+    assert.equal(sent.length, 0, "repeated keydown must be ignored")
+
+    input.onKeyDown(keyEvent({ key: "KanaMode", code: "KanaMode", repeat: false }))
+    assert.equal(sent.length, 2)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_KANA)
+})
+
+test("ambiguous Process+Backquote is logged but stays normalized", () => {
+    const { input, sent, logs } = setup()
+
+    input.onKeyDown(keyEvent({ key: "Process", code: "Backquote", keyCode: 0xe5, isComposing: true }))
+    input.onKeyUp(keyEvent({ key: "Process", code: "Backquote", keyCode: 0xe5, isComposing: true }))
+
+    assert.equal(sent.length, 2)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_OEM_3)
+    assert.equal(sent[0].data.flags.sunshineNonNormalized, false, "ambiguous key must not be forced non normalized")
+
+    const diag = jisDiag(logs)
+    assert.equal(diag.length, 2)
+    assert.ok(diag[0].includes("key=Process"))
+    assert.ok(diag[0].includes("isComposing=true"))
+    assert.ok(diag[0].includes("nonNormalized=false"))
+})
+
+test("ordinary text input is never diagnosed", () => {
+    const { input, sent, logs } = setup()
+
+    input.onKeyDown(keyEvent({ key: "a", code: "KeyA", keyCode: 65 }))
+    input.onKeyUp(keyEvent({ key: "a", code: "KeyA", keyCode: 65 }))
+    input.onKeyDown(keyEvent({ key: "`", code: "Backquote", keyCode: 192 }))
+    input.onKeyUp(keyEvent({ key: "`", code: "Backquote", keyCode: 192 }))
+
+    assert.equal(sent.length, 4)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_KEY_A)
+    assert.equal(sent[2].data.keyCode, StreamKeys.VK_OEM_3)
+    assert.equal(sent[2].data.flags.sunshineNonNormalized, false)
+    assert.equal(jisDiag(logs).length, 0, "ordinary text must not be logged")
+})
+
+test("remote half/full toggle sends a non normalized VK_OEM_3 tap", () => {
+    const { input, sent } = setup()
+
+    input.sendJapaneseHalfFullWidthToggle()
+
+    assert.equal(sent.length, 2)
+    assert.equal(sent[0].data.action, KeyAction.Down)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_OEM_3)
+    assert.equal(sent[0].data.flags.sunshineNonNormalized, true)
+    assert.equal(sent[1].data.action, KeyAction.Up)
+    assert.equal(sent[1].data.flags.sunshineNonNormalized, true)
+})
+
+test("henkan/muhenkan are sent as taps too", () => {
+    const { input, sent } = setup()
+
+    input.onKeyDown(keyEvent({ key: "Convert", code: "Convert" }))
+    assert.equal(sent.length, 2)
+    assert.equal(sent[0].data.keyCode, StreamKeys.VK_CONVERT)
+    assert.equal(sent[0].data.flags.sunshineNonNormalized, true)
+
+    input.onKeyDown(keyEvent({ key: "NonConvert", code: "NonConvert" }))
+    assert.equal(sent.length, 4)
+    assert.equal(sent[2].data.keyCode, StreamKeys.VK_NONCONVERT)
+    assert.equal(sent[2].data.flags.sunshineNonNormalized, true)
+})
diff --git a/tests/jis/keyboard.test.ts b/tests/jis/keyboard.test.ts
new file mode 100644
index 0000000..7207e26
--- /dev/null
+++ b/tests/jis/keyboard.test.ts
@@ -0,0 +1,186 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+
+import { StreamKeys } from "../../web/api_bindings.ts"
+import {
+    convertToKey,
+    eventNeedsSunshineNonNormalized,
+    isJapaneseHalfFullWidthKey,
+    isJapaneseImeModeKey,
+    isLikelyJapaneseModeKey,
+    needsSunshineNonNormalized,
+} from "../../web/stream/keyboard.ts"
+
+// A KeyboardEvent shape is all the pure functions below look at. Building plain
+// objects keeps the tests independent from any DOM implementation.
+function keyEvent(overrides: Record<string, unknown> = {}): KeyboardEvent {
+    return {
+        type: "keydown",
+        code: "",
+        key: "",
+        keyCode: 0,
+        isComposing: false,
+        repeat: false,
+        shiftKey: false,
+        ctrlKey: false,
+        altKey: false,
+        metaKey: false,
+        ...overrides,
+    } as unknown as KeyboardEvent
+}
+
+// -- needsSunshineNonNormalized ------------------------------------------------
+
+test("needsSunshineNonNormalized flags only the JIS specific keys", () => {
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_OEM_102), true) // ro
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_KANA), true) // kana
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_CONVERT), true) // henkan
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_NONCONVERT), true) // muhenkan
+
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_OEM_3), false) // ` / 半角全角 slot
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_OEM_5), false) // yen slot keeps normalized
+    assert.equal(needsSunshineNonNormalized(StreamKeys.VK_KEY_A), false)
+})
+
+// -- Windows (Chrome/Edge) -----------------------------------------------------
+
+test("Windows 半角/全角 is a half/full width key", () => {
+    for (const event of [
+        keyEvent({ key: "Hankaku", code: "Backquote", keyCode: 0x15 }),
+        keyEvent({ key: "Zenkaku", code: "Backquote", keyCode: 0x15 }),
+        keyEvent({ key: "ZenkakuHankaku", code: "Backquote", keyCode: 0x15 }),
+        keyEvent({ key: "KanjiMode", code: "Backquote", keyCode: 0x15 }),
+    ]) {
+        assert.equal(isJapaneseHalfFullWidthKey(event), true, `${event.key} should be half/full`)
+        assert.equal(convertToKey(event), StreamKeys.VK_OEM_3, `${event.key} should map to VK_OEM_3`)
+        assert.equal(eventNeedsSunshineNonNormalized(event, StreamKeys.VK_OEM_3), true, `${event.key} needs non normalized`)
+        assert.equal(isLikelyJapaneseModeKey(event), true)
+    }
+})
+
+test("Windows Kana key maps to VK_KANA", () => {
+    for (const event of [
+        keyEvent({ key: "KanaMode", code: "KanaMode" }),
+        keyEvent({ key: "Hiragana", code: "KanaMode" }),
+        keyEvent({ key: "Katakana", code: "KanaMode" }),
+        keyEvent({ key: "KanaMode", code: "Unidentified", keyCode: 0x15 }),
+    ]) {
+        assert.equal(convertToKey(event), StreamKeys.VK_KANA, `${event.key}/${event.code} should map to VK_KANA`)
+        assert.equal(eventNeedsSunshineNonNormalized(event, StreamKeys.VK_KANA), true)
+        assert.equal(isJapaneseHalfFullWidthKey(event), false)
+        assert.equal(isJapaneseImeModeKey(event), true)
+    }
+})
+
+test("Windows henkan/muhenkan map to VK_CONVERT/VK_NONCONVERT", () => {
+    const henkan = keyEvent({ key: "Convert", code: "Convert" })
+    assert.equal(convertToKey(henkan), StreamKeys.VK_CONVERT)
+    assert.equal(eventNeedsSunshineNonNormalized(henkan, StreamKeys.VK_CONVERT), true)
+    assert.equal(isJapaneseImeModeKey(henkan), true)
+
+    const muhenkan = keyEvent({ key: "NonConvert", code: "NonConvert" })
+    assert.equal(convertToKey(muhenkan), StreamKeys.VK_NONCONVERT)
+    assert.equal(eventNeedsSunshineNonNormalized(muhenkan, StreamKeys.VK_NONCONVERT), true)
+    assert.equal(isJapaneseImeModeKey(muhenkan), true)
+})
+
+// -- Linux (Firefox) -----------------------------------------------------------
+
+test("Linux 半角/全角 (Lang5) is a half/full width key", () => {
+    for (const event of [
+        keyEvent({ key: "Hankaku", code: "Lang5" }),
+        keyEvent({ key: "ZenkakuHankaku", code: "Lang5" }),
+        keyEvent({ key: "Zenkaku", code: "Lang5" }),
+    ]) {
+        assert.equal(isJapaneseHalfFullWidthKey(event), true)
+        assert.equal(convertToKey(event), StreamKeys.VK_OEM_3)
+        assert.equal(eventNeedsSunshineNonNormalized(event, StreamKeys.VK_OEM_3), true)
+    }
+})
+
+test("Linux Kana key (Lang3/Lang4/KanaMode) maps to VK_KANA", () => {
+    for (const event of [
+        keyEvent({ key: "Hiragana", code: "Lang3" }),
+        keyEvent({ key: "Katakana", code: "Lang4" }),
+        keyEvent({ key: "KanaMode", code: "KanaMode" }),
+    ]) {
+        assert.equal(convertToKey(event), StreamKeys.VK_KANA, `${event.key}/${event.code}`)
+        assert.equal(isJapaneseHalfFullWidthKey(event), false)
+    }
+})
+
+// -- Yen and Ro ----------------------------------------------------------------
+
+test("JIS yen (IntlYen) maps to VK_OEM_5 and needs non normalized", () => {
+    const yen = keyEvent({ key: "¥", code: "IntlYen", keyCode: 0xdc })
+    assert.equal(convertToKey(yen), StreamKeys.VK_OEM_5)
+    assert.equal(eventNeedsSunshineNonNormalized(yen, StreamKeys.VK_OEM_5), true)
+    assert.equal(isJapaneseHalfFullWidthKey(yen), false)
+})
+
+test("JIS ro (IntlRo) maps to VK_OEM_102 and needs non normalized", () => {
+    const ro = keyEvent({ key: "\\", code: "IntlRo", keyCode: 0xc1 })
+    assert.equal(convertToKey(ro), StreamKeys.VK_OEM_102)
+    assert.equal(eventNeedsSunshineNonNormalized(ro, StreamKeys.VK_OEM_102), true)
+    assert.equal(isJapaneseHalfFullWidthKey(ro), false)
+})
+
+// -- Ambiguity guards ----------------------------------------------------------
+
+test("US Backquote is not treated as a Japanese key", () => {
+    for (const event of [
+        keyEvent({ key: "`", code: "Backquote", keyCode: 192 }),
+        keyEvent({ key: "~", code: "Backquote", keyCode: 192, shiftKey: true }),
+    ]) {
+        assert.equal(isJapaneseHalfFullWidthKey(event), false)
+        assert.equal(isJapaneseImeModeKey(event), false)
+        assert.equal(isLikelyJapaneseModeKey(event), false)
+        assert.equal(convertToKey(event), StreamKeys.VK_OEM_3)
+        // A US backtick/tilde on the grave slot stays normalized.
+        assert.equal(eventNeedsSunshineNonNormalized(event, StreamKeys.VK_OEM_3), false)
+    }
+})
+
+test("unknown labels on the backquote slot are diagnosed but stay normalized", () => {
+    for (const event of [
+        keyEvent({ key: "Unidentified", code: "Backquote", keyCode: 0 }),
+        keyEvent({ key: "", code: "Backquote", keyCode: 0 }),
+        keyEvent({ key: "Process", code: "Backquote", keyCode: 0xe5, isComposing: true }),
+    ]) {
+        assert.equal(isJapaneseHalfFullWidthKey(event), false, "must not be force classified as half/full")
+        assert.equal(isJapaneseImeModeKey(event), false)
+        assert.equal(isLikelyJapaneseModeKey(event), true, "should be diagnosed")
+        assert.equal(convertToKey(event), StreamKeys.VK_OEM_3)
+        assert.equal(eventNeedsSunshineNonNormalized(event, StreamKeys.VK_OEM_3), false)
+    }
+})
+
+test("ambiguous keyCode 0x15 on the Backquote slot is not classified as half/full", () => {
+    const ambiguous = keyEvent({ key: "`", code: "Backquote", keyCode: 0x15 })
+    // Must NOT be force classified as 半角/全角: it could be a US backtick.
+    assert.equal(isJapaneseHalfFullWidthKey(ambiguous), false)
+    // It is ambiguous, so it is surfaced for diagnostics instead.
+    assert.equal(isLikelyJapaneseModeKey(ambiguous), true)
+    assert.equal(eventNeedsSunshineNonNormalized(ambiguous, convertToKey(ambiguous)!), false)
+})
+
+test("ambiguous Process+Backquote is diagnosed, not translated as Japanese", () => {
+    const process = keyEvent({ key: "Process", code: "Backquote", keyCode: 0xe5, isComposing: true })
+    assert.equal(isJapaneseHalfFullWidthKey(process), false)
+    assert.equal(isJapaneseImeModeKey(process), false)
+    assert.equal(isLikelyJapaneseModeKey(process), true)
+    // Falls through to the plain grave mapping, keeping the US/JIS slot meaning.
+    assert.equal(convertToKey(process), StreamKeys.VK_OEM_3)
+    assert.equal(eventNeedsSunshineNonNormalized(process, StreamKeys.VK_OEM_3), false)
+})
+
+test("ordinary text keys are never likely JIS mode keys", () => {
+    for (const event of [
+        keyEvent({ key: "a", code: "KeyA", keyCode: 65 }),
+        keyEvent({ key: "1", code: "Digit1", keyCode: 49 }),
+        keyEvent({ key: "Enter", code: "Enter", keyCode: 13 }),
+        keyEvent({ key: " ", code: "Space", keyCode: 32 }),
+    ]) {
+        assert.equal(isLikelyJapaneseModeKey(event), false, `${event.code} must not be logged`)
+    }
+})
