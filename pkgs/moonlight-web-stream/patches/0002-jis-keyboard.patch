+// Stand-ins for the browser/wasm only dependencies of web/stream/input.ts.
+// Only the parts the JIS input logic touches are meaningful; everything else
+// exists so node's ESM linker can satisfy the named imports.
+
+export const showNotification = (..._args) => { }
+
+class Packet {
+    data
+    constructor(data) {
+        this.data = data
+    }
+}
+
+export const KeyAction = { Down: 0, Up: 1 }
+export const MouseButton = { Left: 0, Middle: 1, Right: 2, X1: 3, X2: 4 }
+export const MouseButtonAction = { Press: 0, Release: 1 }
+export const TouchEventType = { Down: 0, Move: 1, Up: 2, Cancel: 3 }
+export const ControllerType = { Unknown: 0 }
+export const ControlPacket_Tags = { ControllerRumbleData: 0, ControllerRumbleTriggers: 1 }
+
+export class ControlPacket extends Packet { }
+ControlPacket.Text = class extends Packet { }
+
+export class ClientInputEvent {
+    static Keyboard = class extends Packet { }
+    static MouseMoveRelative = class extends Packet { }
+    static MouseMoveAbsolute = class extends Packet { }
+    static MouseButton = class extends Packet { }
+    static MouseScrollHorizontal = class extends Packet { }
+    static MouseScrollVertical = class extends Packet { }
+    static Touch = class extends Packet { }
+    static ControllerConnect = class extends Packet { }
+    static ControllerDisconnect = class extends Packet { }
+    static ControllerState = class extends Packet { }
+}
+
+export const U16_MAX = 65535
+
+export const emptyGamepadState = () => ({
+    buttonFlags: 0,
+    leftTrigger: 0,
+    rightTrigger: 0,
+    leftStickX: 0,
+    leftStickY: 0,
+    rightStickX: 0,
+    rightStickY: 0,
+})
+export const extractGamepadState = () => emptyGamepadState()
+export const areGamepadStatesEqual = () => true
+export const SUPPORTED_BUTTONS = {}
+export const convertToButton = () => null
+
+// These are used as types only in the real sources. They are exported as values
+// so that node's ESM linker can resolve the named imports.
+export const ControllerButtons = undefined
+export const ControllerCapabilities = undefined
+export const KeyModifiers = undefined
+export const ControllerConfig = undefined
+export const GamepadState = undefined
+export const StreamCapabilities = undefined
+export const IControlStream = undefined
